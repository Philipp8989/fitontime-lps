{
  "framework": "astro",
  "redirects": [
    { "source": "/schilddruesen-analyse", "destination": "/so-funktioniert-fot", "permanent": true },
    { "source": "/schilddruesen-analyse/", "destination": "/so-funktioniert-fot/", "permanent": true },
    { "source": "/schilddruesen-analyse/:path*", "destination": "/so-funktioniert-fot/:path*", "permanent": true },
    { "source": "/longevity", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://longevity.fit-on-time.ch/", "permanent": false },
    { "source": "/longevity/:path*", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://longevity.fit-on-time.ch/longevity/:path*", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://go.abnehmen-ohne-stress.ch/", "permanent": false },
    { "source": "/:slug(stoffwechsel-report|koerpertyp-test|figur-check|koerper-report|ab-40|bauchfett|insulin-check)", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://go.abnehmen-ohne-stress.ch/:slug", "permanent": false },
    { "source": "/:slug(stoffwechsel-report|koerpertyp-test|figur-check|koerper-report|ab-40|bauchfett|insulin-check)/", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://go.abnehmen-ohne-stress.ch/:slug/", "permanent": false },
    { "source": "/:slug(stoffwechsel-report|koerpertyp-test|figur-check|koerper-report|ab-40|bauchfett|insulin-check)/:path*", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://go.abnehmen-ohne-stress.ch/:slug/:path*", "permanent": false },
    { "source": "/:slug(stoffwechsel-report|koerpertyp-test|figur-check|koerper-report|ab-40|bauchfett|insulin-check)/:path*/", "has": [{ "type": "host", "value": "start.fitontime.ch" }], "destination": "https://go.abnehmen-ohne-stress.ch/:slug/:path*/", "permanent": false }
  ],
  "crons": [
    { "path": "/api/cron/funnel-health", "schedule": "0 */3 * * *" }
  ]
}
