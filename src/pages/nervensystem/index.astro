---
// Nervensystem-Check: Vorschaltung zum Reset-Abend (Ads Nervensystem 1 bis 4).
// Mechanik nach dem Nervensystem-Typ-Test der Achtsamkeitsakademie (Meta-Werbebibliothek 08.10.2026):
// erste Frage startet den Check, Skalen- und Alltagsfragen, Zwischenlob, Auswertung mit Ja-Frage,
// danach nur Vorname und E-Mail. Thema hier: Nervensystem als Grund, warum Abnehmen nicht klappt.
// Ergebnis auf /nervensystem/ergebnis/, von dort Ein-Klick-Anmeldung zum Reset-Abend (?q=nervensystem).
import '../../styles/bauchfett.css';
import '../../styles/nervensystem.css';
import CookieBanner from '../../components/CookieBanner.astro';
import ScaleeeCredit from '../../components/ScaleeeCredit.astro';
import FotWordmark from '../../components/FotWordmark.astro';
const impressumUrl = 'https://fitontime.ch/impressum-datenschutz';
const datenschutzUrl = 'https://fitontime.ch/impressum-datenschutz';
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-955413991').trim();
const FONTS = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..500,0..100;1,9..144,300..500,0..100&family=Albert+Sans:wght@400;500;600&display=swap';
---
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // A/B-Splitter Nervensystem (seit 09.10.2026): alle Ads zeigen hierher, 50 % gehen fest auf Kevins Variante B.
    // Zuteilung bleibt pro Browser gleich (fot_ns_variant). QA: ?v=a oder ?v=b erzwingt die Variante.
    (function () {
      var k = 'fot_ns_variant', q = new URLSearchParams(location.search).get('v'), v;
      try { v = localStorage.getItem(k); } catch (e) {}
      if (q === 'a' || q === 'b') v = q;
      if (v !== 'a' && v !== 'b') v = Math.random() < 0.5 ? 'a' : 'b';
      try { localStorage.setItem(k, v); } catch (e) {}
      if (v === 'b') location.replace('/nervensystem-b/' + location.search + location.hash);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Nervensystem-Check: Bremst dein Nervensystem dein Abnehmen? | Fit on Time</title>
  <meta name="description" content="Du nimmst nicht ab, weil dein Nervensystem im Daueralarm steckt. Der Check zeigt dir in 2 Minuten, wie stark es dich gerade ausbremst." />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={FONTS} rel="stylesheet" />
</head>
<body>

  <!-- ===== LANDING ===== -->
  <div id="lp">
    <div class="wrap">
      <div class="topbar">
        <FotWordmark />
        <span class="tag">Nervensystem-Check</span>
      </div>
    </div>

    <section class="hero">
      <div class="arc arc--hero"></div>
      <div class="wrap wrap--wide hero-grid">
        <div>
          <p class="eyebrow">2 Minuten · 10 Fragen · kostenlos</p>
          <h1>Du nimmst nicht ab, weil dein Nervensystem <em>im Daueralarm steckt.</em></h1>
          <p class="lead">Nicht wegen deiner Disziplin. Nicht wegen der Kalorien. Ein Nervensystem, das nie abschaltet, meldet deinem Körper: Gefahr, festhalten. Solange das so bleibt, bringt keine Diät etwas. Der Check zeigt dir in 2 Minuten, wie stark dein Nervensystem dich gerade ausbremst.</p>
          <p class="lead hide-sm" style="font-size:0.95rem;">Von Fit on Time. Seit 2016 über 4'000 Frauen in der Schweiz begleitet.</p>
        </div>

        <div class="gate">
          <div class="gate-q">Abends, wenn endlich Ruhe ist: Was passiert bei dir?</div>
          <div class="gate-sub">Tipp auf die Antwort, die am ehesten passt. Damit startet der Check.</div>
          <div class="opts">
            <button class="opt" onclick="startQuiz('kopf')">Mein Kopf läuft weiter, ich komme nicht runter</button>
            <button class="opt" onclick="startQuiz('kuehlschrank')">Ich stehe vor dem Kühlschrank, obwohl ich keinen Hunger habe</button>
            <button class="opt" onclick="startQuiz('sofa')">Ich falle aufs Sofa und kriege nichts mehr hin</button>
            <button class="opt" onclick="startQuiz('ruhig')">Ich bin entspannt und komme gut runter</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Belegte Zahlen (design-pool beweis/fakten-zeile) -->
    <section class="fz" aria-label="Fit on Time in Zahlen">
      <div class="fz-wrap">
        <div class="fz-item"><strong>4'000+</strong><span>Frauen begleitet</span><small>seit 2016</small></div>
        <div class="fz-item"><strong>4,8</strong><span>Sterne auf Google</span><small>567 Rezensionen · Stand 09/2026</small></div>
        <div class="fz-item"><strong>4,4</strong><span>Sterne auf Trustpilot</span><small>208 Bewertungen · Stand 09/2026</small></div>
        <div class="fz-item"><strong>4</strong><span>Standorte in der Schweiz</span><small>Frauenfeld · Zürich · Bern · St. Gallen</small></div>
      </div>
    </section>

    <!-- Nervensystem-Regler (interaktiv) -->
    <section class="section section--bright">
      <div class="wrap wrap--wide regler-grid">
        <div>
          <p class="eyebrow">Der Grund, über den keiner spricht</p>
          <h2>Alle reden über Kalorien. <em>Kaum jemand über dein Nervensystem.</em></h2>
          <p class="lead">Montag läuft es, ab Mittwoch ist alles egal. Abends stehst du vor dem Kühlschrank, obwohl du keinen Hunger hast. Das ist kein Charakterfehler. So reagiert ein Nervensystem, das den ganzen Tag unter Strom steht.</p>
          <p class="lead hide-sm">Schieb den Regler und schau, was mit deinem Körper passiert.</p>
        </div>
        <div class="regler" id="regler">
          <div class="r-head"><span>Dein Nervensystem</span><b id="rName">Daueralarm</b></div>
          <input type="range" id="rIn" min="0" max="100" value="82" aria-label="Wie angespannt ist dein Nervensystem?" />
          <div class="r-ends"><span>Ruhe</span><span>Anspannung</span><span>Alarm</span></div>
          <div class="r-meters">
            <div class="r-m"><div class="r-l"><span>Körper hält fest</span><i id="m1t"></i></div><div class="r-bar"><i id="m1"></i></div></div>
            <div class="r-m"><div class="r-l"><span>Hunger am Abend</span><i id="m2t"></i></div><div class="r-bar"><i id="m2"></i></div></div>
            <div class="r-m"><div class="r-l"><span>Kraft zum Durchhalten</span><i id="m3t"></i></div><div class="r-bar"><i id="m3"></i></div></div>
          </div>
          <p class="r-text" id="rText"></p>
          <button class="btn btn--primary btn--block" type="button" onclick="zumStart()">Wo stehst du? Check starten <span class="btn-arrow">&rarr;</span></button>
        </div>
      </div>
    </section>

    <!-- Drei Muster als Tabs (interaktiv) -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Was der Check zeigt</p>
          <h2>Wie dein Nervensystem <em>dich ausbremst.</em></h2>
          <p class="lead">Es gibt drei Muster. Tipp eins an.</p>
        </div>
        <div class="tabs" role="tablist" aria-label="Die drei Muster">
          <button role="tab" aria-selected="true" aria-controls="tp-a" id="tb-a" onclick="tab('a')"><span>01</span>Daueralarm</button>
          <button role="tab" aria-selected="false" aria-controls="tp-l" id="tb-l" onclick="tab('l')"><span>02</span>Leerer Akku</button>
          <button role="tab" aria-selected="false" aria-controls="tp-x" id="tb-x" onclick="tab('x')"><span>03</span>Achterbahn</button>
        </div>
        <div class="tp" role="tabpanel" id="tp-a"><h3>Dein Nervensystem kommt nicht mehr runter.</h3><p>Kopf an, Körper angespannt, das Stresshormon Cortisol bleibt oben. Dein Körper hält fest, vor allem am Bauch. Abends sucht dein Nervensystem Ruhe, und findet sie im Essen.</p><p class="tp-sign">Typisch: «Ich liege im Bett und der Kopf läuft weiter.»</p></div>
        <div class="tp" role="tabpanel" id="tp-l" hidden><h3>Dein Nervensystem ist erschöpft.</h3><p>Nach langer Anspannung hat es die Notbremse gezogen. Du schläfst und bist trotzdem müde, dein Körper schaltet auf Sparflamme und verbraucht weniger.</p><p class="tp-sign">Typisch: «Ich esse wenig und nehme trotzdem nicht ab.»</p></div>
        <div class="tp" role="tabpanel" id="tp-x" hidden><h3>Dein Nervensystem fährt Achterbahn.</h3><p>Vollgas, dann Absturz, dazwischen keine Mitte. Mit jedem Absturz kommt der Heisshunger, und am Montag fängst du wieder von vorne an.</p><p class="tp-sign">Typisch: «Ein Stück Kuchen, und dann ist eh alles egal.»</p></div>
      </div>
    </section>

    <!-- Atemübung (interaktiv) -->
    <section class="section section--sand">
      <div class="wrap wrap--wide atem-grid">
        <div>
          <p class="eyebrow">Spür es selbst · 60 Sekunden</p>
          <h2>So schnell merkt dein Nervensystem, <em>dass es runterfahren darf.</em></h2>
          <p class="lead">4 Sekunden einatmen, 6 Sekunden aus. Längeres Ausatmen ist das einfachste Signal an deinen Körper, dass keine Gefahr droht. Probier es jetzt, sechs Runden.</p>
        </div>
        <div class="atem">
          <div class="atem-kreis" id="aKreis"><span id="aText">Bereit?</span><small id="aZahl"></small></div>
          <button class="btn btn--outline" type="button" id="aBtn" onclick="atem()">Übung starten</button>
          <p class="atem-runde" id="aRunde">6 Runden · 1 Minute</p>
        </div>
      </div>
    </section>

    <!-- Erfolge (design-pool beweis/erfolge-drei) -->
    <section class="section">
      <div class="wrap wrap--wide">
        <div class="section-head">
          <p class="eyebrow">Frauen, die den Weg gegangen sind</p>
          <h2>Als der Körper aufgehört hat festzuhalten, <em>ging es.</em></h2>
        </div>
        <div class="e3">
          <figure><div class="e3-img"><img src="/images/nervensystem/kundin-a.webp" alt="Kundin von Fit on Time, vorher und nachher" loading="lazy" width="800" height="652" /></div><figcaption><b>Kundin von Fit on Time</b><span>vorher · nachher</span></figcaption></figure>
          <figure><div class="e3-img"><img src="/images/nervensystem/kundin-b.webp" alt="Kundin von Fit on Time, vorher und nachher" loading="lazy" width="800" height="652" /></div><figcaption><b>Kundin von Fit on Time</b><span>vorher · nachher</span></figcaption></figure>
          <blockquote class="e3-quote"><p>«Ich hätte nie gedacht, dass ich mal so begeistert sein werde.»</p><div class="e3-who"><strong>−16,3 kg</strong><b>Coco, Floristin</b><span>Grösse 46 auf 40</span></div></blockquote>
        </div>
        <p class="fine-note"><span class="swipe">Wischen für mehr · </span>Ergebnisse sind individuell.</p>
      </div>
    </section>

    <!-- FAQ (design-pool faq/zwei-spalten-linien) -->
    <section class="section section--bright">
      <div class="wrap wrap--wide">
        <div class="section-head">
          <p class="eyebrow">Kurz gefragt</p>
          <h2>Bevor du <em>startest.</em></h2>
        </div>
        <dl class="fl">
          <div><dt>Was kostet der Check?</dt><dd>Nichts. Du beantwortest 10 Fragen und siehst dein Ergebnis sofort.</dd></div>
          <div><dt>Wie lange dauert er?</dt><dd>Etwa 2 Minuten. Es gibt kein Richtig oder Falsch, antworte aus dem Bauch heraus.</dd></div>
          <div><dt>Ist das eine Diagnose?</dt><dd>Nein. Der Check ist eine Einschätzung anhand deiner Antworten. Bei anhaltenden Beschwerden geh bitte zu deiner Ärztin oder deinem Arzt.</dd></div>
          <div><dt>Was passiert mit meinen Daten?</dt><dd>Wir schicken dir dein Ergebnis und eine Einladung zum kostenlosen Reset-Abend. Keine Weitergabe, abmelden geht jederzeit.</dd></div>
        </dl>
      </div>
    </section>

    <!-- Nochmal die erste Frage -->
    <section class="section">
      <div class="wrap">
        <div class="gate gate--end">
          <div class="gate-q">Abends, wenn endlich Ruhe ist: Was passiert bei dir?</div>
          <div class="gate-sub">Die erste Frage. Damit startet der Check.</div>
          <div class="opts">
            <button class="opt" onclick="startQuiz('kopf')">Mein Kopf läuft weiter, ich komme nicht runter</button>
            <button class="opt" onclick="startQuiz('kuehlschrank')">Ich stehe vor dem Kühlschrank, obwohl ich keinen Hunger habe</button>
            <button class="opt" onclick="startQuiz('sofa')">Ich falle aufs Sofa und kriege nichts mehr hin</button>
            <button class="opt" onclick="startQuiz('ruhig')">Ich bin entspannt und komme gut runter</button>
          </div>
        </div>
      </div>
    </section>
    <div class="wrap">
      <footer>
        <a href={impressumUrl} target="_blank" rel="noopener">Impressum</a> &middot;
        <a href={datenschutzUrl} target="_blank" rel="noopener">Datenschutzerklärung</a>
        <p class="fine">Der Nervensystem-Check ist eine Einschätzung anhand deiner Antworten und ersetzt keine ärztliche Abklärung. Ergebnisse sind individuell.</p>
        <div style="margin-top:10px;text-align:center;"><ScaleeeCredit /></div>
      </footer>
    </div>
  </div>

  <!-- ===== QUIZ ===== -->
  <div id="quiz">
    <div class="q-head"><FotWordmark /></div>
    <div class="q-progress"><div class="q-bar"><div class="q-fill" id="qf"></div></div><div class="q-num" id="qn">Frage 2 von 10</div></div>
    <div class="q-body">

      <div class="step on" data-s="2">
        <h2>Wie alt bist du?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(2,'u35')">Unter 35</button>
          <button class="opt" onclick="nxt(2,'35-44')">35 bis 44</button>
          <button class="opt" onclick="nxt(2,'45-54')">45 bis 54</button>
          <button class="opt" onclick="nxt(2,'55+')">55 oder älter</button>
        </div>
      </div>

      <div class="step" data-s="3">
        <h2>Ich komme innerlich nicht runter, selbst wenn ich Zeit zum Ausruhen hätte.</h2>
        <p class="q-sub">Wie sehr trifft das auf dich zu?</p>
        <div class="scale">
          <button class="opt" onclick="nxt(3,1)">1</button><button class="opt" onclick="nxt(3,2)">2</button><button class="opt" onclick="nxt(3,3)">3</button><button class="opt" onclick="nxt(3,4)">4</button><button class="opt" onclick="nxt(3,5)">5</button>
        </div>
        <div class="scale-ends"><span>Gar nicht</span><span>Voll und ganz</span></div>
      </div>

      <div class="step" data-s="4">
        <h2>Wie schläfst du im Moment?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(4,'gut')">Meistens gut</button>
          <button class="opt" onclick="nxt(4,'gedanken')">Ich schlafe schlecht ein<small>Die Gedanken drehen sich weiter</small></button>
          <button class="opt" onclick="nxt(4,'wach')">Ich wache nachts auf<small>Oft zwischen 2 und 4 Uhr</small></button>
          <button class="opt" onclick="nxt(4,'erschoepft')">Ich schlafe genug und bin trotzdem erschöpft</button>
        </div>
        <div class="tipp"><strong>Gut zu wissen:</strong> Ein Nervensystem im Alarm lässt dich nachts nicht abschalten. Und wer schlecht schläft, hat am nächsten Tag mehr Hunger, vor allem auf Süsses.</div>
      </div>

      <div class="step" data-s="5">
        <h2>Morgens bin ich schon müde, bevor der Tag richtig angefangen hat.</h2>
        <p class="q-sub">Wie sehr trifft das auf dich zu?</p>
        <div class="scale">
          <button class="opt" onclick="nxt(5,1)">1</button><button class="opt" onclick="nxt(5,2)">2</button><button class="opt" onclick="nxt(5,3)">3</button><button class="opt" onclick="nxt(5,4)">4</button><button class="opt" onclick="nxt(5,5)">5</button>
        </div>
        <div class="scale-ends"><span>Gar nicht</span><span>Voll und ganz</span></div>
      </div>

      <div class="step pause" data-s="p">
        <h2>Du machst das <em>gut.</em></h2>
        <p>Dein Nervensystem-Muster zeichnet sich schon ab. Nur noch 5 Fragen.</p>
        <button class="btn btn--primary btn--block" onclick="weiter()">Weiter <span class="btn-arrow">&rarr;</span></button>
      </div>

      <div class="step" data-s="6">
        <h2>Wie läuft eine normale Woche mit deinen Vorsätzen?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(6,'mittwoch')">Am Anfang gut, ab Mittwoch ist alles egal</button>
          <button class="opt" onclick="nxt(6,'waage')">Ich halte durch, aber die Waage bewegt sich nicht</button>
          <button class="opt" onclick="nxt(6,'kraft')">Mir fehlt schon die Kraft, überhaupt anzufangen</button>
          <button class="opt" onclick="nxt(6,'pause')">Ich bin ständig unter Strom, Essen ist meine Pause</button>
        </div>
      </div>

      <div class="step" data-s="7">
        <h2>Wann kommt der Heisshunger?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(7,'nachmittag')">Am Nachmittag, gegen 16 Uhr</button>
          <button class="opt" onclick="nxt(7,'abend')">Abends, wenn endlich Ruhe ist</button>
          <button class="opt" onclick="nxt(7,'stress')">Wenn ich gestresst bin, egal wann</button>
          <button class="opt" onclick="nxt(7,'selten')">Eher selten</button>
        </div>
        <div class="tipp"><strong>Gut zu wissen:</strong> Heisshunger am Abend ist oft kein echter Hunger. Es ist dein Nervensystem, das die Pause sucht, die es tagsüber nicht bekommen hat.</div>
      </div>

      <div class="step" data-s="8">
        <h2>Ein Stück Kuchen bei der Arbeit, und ich denke: Heute ist es eh egal.</h2>
        <p class="q-sub">Wie sehr trifft das auf dich zu?</p>
        <div class="scale">
          <button class="opt" onclick="nxt(8,1)">1</button><button class="opt" onclick="nxt(8,2)">2</button><button class="opt" onclick="nxt(8,3)">3</button><button class="opt" onclick="nxt(8,4)">4</button><button class="opt" onclick="nxt(8,5)">5</button>
        </div>
        <div class="scale-ends"><span>Gar nicht</span><span>Voll und ganz</span></div>
      </div>

      <div class="step" data-s="9">
        <h2>Wie oft kippst du zwischen Vollgas und komplett leer?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(9,'oft')">Oft</button>
          <button class="opt" onclick="nxt(9,'manchmal')">Manchmal</button>
          <button class="opt" onclick="nxt(9,'nie')">Fast nie</button>
        </div>
      </div>

      <div class="step" data-s="10">
        <h2>Was hast du schon probiert?</h2>
        <div class="opts">
          <button class="opt" onclick="nxt(10,'kalorien')">Kalorien zählen, weniger essen</button>
          <button class="opt" onclick="nxt(10,'sport')">Mehr Sport</button>
          <button class="opt" onclick="nxt(10,'fasten')">Intervallfasten</button>
          <button class="opt" onclick="nxt(10,'alles')">Alles davon</button>
          <button class="opt" onclick="nxt(10,'nichts')">Noch nichts davon</button>
        </div>
        <div class="tipp"><strong>Gut zu wissen:</strong> Für ein überlastetes Nervensystem sind weniger essen und mehr Sport noch mehr Stress. Darum wird es mit jedem Versuch schwerer, nicht leichter.</div>
      </div>

      <!-- Auswertung mit Ja-Frage -->
      <div class="step ld" data-s="ld">
        <div class="spinner"></div>
        <h2>Wir werten dein Nervensystem aus</h2>
        <p>Einen Moment noch</p>
        <div class="checks">
          <div class="chk" id="c1"><i>&#10003;</i>Antworten ausgewertet</div>
          <div class="chk" id="c2"><i>&#10003;</i>Nervensystem-Muster erkannt</div>
          <div class="chk" id="c3"><i>&#10003;</i>Belastung berechnet</div>
        </div>
        <div class="ask" id="ask">
          <p>Würdest du 10 Minuten am Tag für dein Nervensystem einplanen, wenn du wüsstest, dass dein Körper dann loslässt?</p>
          <div class="row">
            <button class="btn btn--outline" onclick="bereit('nein')">Nein</button>
            <button class="btn btn--primary" onclick="bereit('ja')">Ja</button>
          </div>
        </div>
      </div>

      <!-- Formular -->
      <div class="step form" data-s="form">
        <div class="tag">Auswertung fertig</div>
        <h2>Dein Nervensystem-Ergebnis <em>ist bereit.</em></h2>
        <p class="sub">Wohin dürfen wir es schicken? Du siehst es sofort und bekommst es zusätzlich per Mail.</p>
        <div class="fields">
          <div class="field"><input type="text" id="fn" placeholder="Dein Vorname" autocomplete="given-name" /></div>
          <div class="field"><input type="email" id="em" placeholder="Deine E-Mail" autocomplete="email" /></div>
          <div class="field"><span class="pre">+41</span><input type="tel" id="ph" placeholder="Handynummer (freiwillig)" autocomplete="tel" /></div>
        </div>
        <p class="form-err" id="formErr" role="alert" hidden></p>
        <div class="cb-row" id="dsRow">
          <input type="checkbox" id="ds" />
          <label for="ds">Ich akzeptiere die <a href={datenschutzUrl} target="_blank" rel="noopener">Datenschutzbestimmungen</a> und bekomme mein Ergebnis per E-Mail. Abmelden geht jederzeit.</label>
        </div>
        <button class="btn btn--primary btn--block" id="sbtn" onclick="send()">Mein Ergebnis ansehen <span class="btn-arrow">&rarr;</span></button>
        <div class="form-proof">Deine Daten sind sicher und werden nicht weitergegeben.</div>
      </div>

    </div>
  </div>

  <script is:inline>
    var A = {};            // Antworten
    var TOTAL = 10;
    // Punkte je Muster: a = Daueralarm, l = Leerer Akku, x = Achterbahn
    var P = { a: 0, l: 0, x: 0 };
    var POINTS = {
      q1: { kopf: { a: 2 }, kuehlschrank: { a: 1, x: 1 }, sofa: { l: 2 }, ruhig: {} },
      q4: { gut: {}, gedanken: { a: 2 }, wach: { a: 2 }, erschoepft: { l: 2 } },
      q6: { mittwoch: { x: 2 }, waage: { l: 2 }, kraft: { l: 2 }, pause: { a: 2 } },
      q7: { nachmittag: { x: 2 }, abend: { a: 2 }, stress: { a: 1, x: 1 }, selten: {} },
      q9: { oft: { x: 2 }, manchmal: { x: 1 }, nie: {} },
      q10: { kalorien: { l: 1 }, sport: { a: 1 }, fasten: { l: 1 }, alles: { a: 1, l: 1, x: 1 }, nichts: {} }
    };
    // Skalenfragen zählen für ein Muster (Wert 4 oder 5 gibt Punkte) und für die Belastung
    var SCALE = { q3: 'a', q5: 'l', q8: 'x' };
    var LABELS = {
      q1: { kopf: 'Kopf läuft weiter', kuehlschrank: 'Kühlschrank ohne Hunger', sofa: 'Sofa, nichts geht mehr', ruhig: 'Entspannt' },
      q2: { u35: 'Unter 35', '35-44': '35 bis 44', '45-54': '45 bis 54', '55+': '55+' },
      q4: { gut: 'Schläft gut', gedanken: 'Schlecht einschlafen', wach: 'Wacht nachts auf', erschoepft: 'Genug Schlaf, trotzdem erschöpft' },
      q6: { mittwoch: 'Ab Mittwoch egal', waage: 'Hält durch, Waage steht', kraft: 'Keine Kraft anzufangen', pause: 'Unter Strom, Essen als Pause' },
      q7: { nachmittag: 'Nachmittags', abend: 'Abends', stress: 'Bei Stress', selten: 'Selten' },
      q9: { oft: 'Oft', manchmal: 'Manchmal', nie: 'Fast nie' },
      q10: { kalorien: 'Kalorien zählen', sport: 'Mehr Sport', fasten: 'Intervallfasten', alles: 'Alles davon', nichts: 'Noch nichts' }
    };
    var ORDER = [2, 3, 4, 5, 'p', 6, 7, 8, 9, 10];

    function tk(e, d) {
      var tries = 0;
      function fire() {
        if (window.__lp) {
          window.__lp.track(e, Object.assign({ page: 'nervensystem' }, d || {}), 'fot', 'Nervensystem-Check');
          if (e === 'quiz_start') window.__lp.meta('ViewContent', { content_name: 'FoT Nervensystem Start', currency: 'CHF' });
          if (e === 'quiz_complete') window.__lp.meta('CompleteRegistration', { content_name: 'FoT Nervensystem Complete', currency: 'CHF' });
          if (e === 'lead_submit') {
            window.__lp.meta('Lead', { content_name: 'FoT Nervensystem Lead', currency: 'CHF' });
            window.__lp.google('generate_lead', 'TnugCP-6zeIcEOfryccD');
          }
        } else if (tries++ < 40) {
          setTimeout(fire, 50);
        }
      }
      fire();
    }
    tk('page_view');

    function add(q, val) {
      if (SCALE[q]) { if (val >= 4) P[SCALE[q]] += val - 3; return; }
      var p = (POINTS[q] || {})[val] || {};
      for (var k in p) P[k] += p[k];
    }

    function zeige(s) {
      document.querySelectorAll('#quiz .step').forEach(function (el) { el.classList.remove('on'); });
      document.querySelector('.step[data-s="' + s + '"]').classList.add('on');
      var i = ORDER.indexOf(s);
      var nr = ORDER.slice(0, i + 1).filter(function (x) { return x !== 'p'; }).length + 1;
      document.getElementById('qf').style.width = Math.round(((nr - 1) / TOTAL) * 100) + '%';
      document.getElementById('qn').textContent = s === 'p' ? 'Halbzeit' : 'Frage ' + nr + ' von ' + TOTAL;
      var q = document.getElementById('quiz'); if (q) q.scrollTop = 0;
      window.scrollTo(0, 0);
    }

    function startQuiz(v) {
      A.q1 = v; A.q1_label = LABELS.q1[v]; add('q1', v);
      tk('quiz_start', { detail: 'q1_' + v });
      document.getElementById('lp').style.display = 'none';
      document.getElementById('quiz').classList.add('on');
      zeige(2);
    }

    function nxt(s, val) {
      var q = 'q' + s;
      A[q] = val; A[q + '_label'] = SCALE[q] ? val + ' von 5' : ((LABELS[q] || {})[val] || val);
      add(q, val);
      tk('quiz_answer', { detail: q + '_' + val });
      var i = ORDER.indexOf(s);
      if (i < ORDER.length - 1) zeige(ORDER[i + 1]);
      else { auswerten(); tk('quiz_complete', { detail: A.ns_typ }); laden(); }
    }
    function weiter() { zeige(6); }

    // Belastung 0 bis 100: Skalen (3 mal 1 bis 5) plus Muster-Punkte, nie unter 18
    function auswerten() {
      var skala = (A.q3 || 1) + (A.q5 || 1) + (A.q8 || 1) - 3;          // 0 bis 12
      var muster = Math.min(14, P.a + P.l + P.x);                        // 0 bis 14
      A.ns_score = Math.max(18, Math.min(96, Math.round((skala / 12) * 55 + (muster / 14) * 45)));
      var typ = 'a';
      if (P.l > P[typ]) typ = 'l';
      if (P.x > P[typ]) typ = 'x';
      A.ns_typ = typ;
      A.ns_typ_label = { a: 'Daueralarm', l: 'Leerer Akku', x: 'Achterbahn' }[typ];
    }

    function laden() {
      var ld = document.querySelector('.step[data-s="ld"]');
      document.querySelectorAll('#quiz .step').forEach(function (el) { el.classList.remove('on'); });
      ld.classList.add('on');
      document.getElementById('qf').style.width = '100%';
      document.getElementById('qn').textContent = 'Auswertung';
      setTimeout(function () { document.getElementById('c1').classList.add('show'); }, 600);
      setTimeout(function () { document.getElementById('ask').classList.add('on'); }, 1400);
    }
    function bereit(v) {
      A.bereit = v === 'ja' ? 'Ja' : 'Nein';
      tk('quiz_answer', { detail: 'bereit_' + v });
      document.getElementById('ask').classList.remove('on');
      setTimeout(function () { document.getElementById('c2').classList.add('show'); }, 300);
      setTimeout(function () { document.getElementById('c3').classList.add('show'); }, 1000);
      setTimeout(function () {
        document.querySelector('.step[data-s="ld"]').classList.remove('on');
        document.querySelector('.step[data-s="form"]').classList.add('on');
        document.getElementById('qn').textContent = 'Fast fertig';
      }, 1800);
    }

    // Gleiche Regeln wie src/lib/phone.ts und src/lib/leadValidation.ts (Server prüft nochmal)
    function normalizePhone(raw) {
      var c = (raw || '').replace(/[^\d+]/g, '');
      if (!c) return '';
      if (c.indexOf('00') === 0) c = '+' + c.slice(2);
      if (c.charAt(0) !== '+') c = c.charAt(0) === '0' ? '+41' + c.slice(1) : '+41' + c;
      if (c.indexOf('+410') === 0) c = '+41' + c.slice(4);
      return c;
    }
    function validName(n) { return n.length <= 80 && !/[\d@]/.test(n) && (n.match(/\p{L}/gu) || []).length >= 2; }
    function validEmail(e) { return e.length <= 254 && /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(e); }
    function validPhone(p) {
      if (!/^\+\d+$/.test(p)) return false;
      if (p.indexOf('+41') === 0) return /^\+41[2-9]\d{8}$/.test(p) || /^\+41(1[5-7]\d{8,9}|6[5-9]\d{7,10})$/.test(p); // DE/AT ohne Vorwahl: Server stellt um
      return p.length - 1 >= 10 && p.length - 1 <= 15;
    }

    function send() {
      var fnEl = document.getElementById('fn'), emEl = document.getElementById('em'), phEl = document.getElementById('ph');
      var fn = fnEl.value.trim(), em = emEl.value.trim(), ph = normalizePhone(phEl.value);
      var errEl = document.getElementById('formErr');
      [fnEl, emEl, phEl].forEach(function (el) { el.parentElement.classList.remove('err'); el.removeAttribute('aria-invalid'); });
      errEl.hidden = true;
      var bad = [];
      if (!validName(fn)) bad.push([fnEl, 'deinen Vornamen']);
      if (!validEmail(em)) bad.push([emEl, 'eine gültige E-Mail']);
      // Handy ist freiwillig, aber wenn eingetragen, dann gültig
      if (ph && !validPhone(ph)) bad.push([phEl, 'eine gültige Handynummer (z. B. 079 123 45 67) oder lass das Feld leer']);
      if (bad.length) {
        bad.forEach(function (b) { b[0].parentElement.classList.add('err'); b[0].setAttribute('aria-invalid', 'true'); });
        var parts = bad.map(function (b) { return b[1]; });
        errEl.textContent = 'Bitte trag ' + (parts.length > 1 ? parts.slice(0, -1).join(', ') + ' und ' + parts[parts.length - 1] : parts[0]) + ' ein.';
        errEl.hidden = false;
        bad[0][0].focus();
        return;
      }
      var dsRow = document.getElementById('dsRow');
      dsRow.classList.remove('error');
      if (!document.getElementById('ds').checked) { dsRow.classList.add('error'); dsRow.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      var btn = document.getElementById('sbtn');
      btn.disabled = true;
      btn.textContent = 'Wird gespeichert';
      fetch('/api/sheets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lp_slug: 'nervensystem',
          lp_name: 'Nervensystem-Check',
          name: fn,
          email: em,
          phone: ph,
          first_name: fn.split(' ')[0],
          answers: A
        })
      }).then(function (res) {
        if (!res.ok) throw new Error('insert-failed');
        tk('lead_submit', { detail: A.ns_typ });
        try {
          sessionStorage.setItem('fot_ns', JSON.stringify({
            name: fn.split(' ')[0] || '', full: fn, email: em, phone: ph,
            typ: A.ns_typ, score: A.ns_score,
            mine: [A.q1_label, A.q4_label, A.q6_label, A.q7_label]
          }));
        } catch (e) {}
        btn.textContent = 'Weiter zu deinem Ergebnis';
        setTimeout(function () { location.href = '/nervensystem/ergebnis/'; }, 250);
      }).catch(function () {
        btn.disabled = false;
        btn.innerHTML = 'Mein Ergebnis ansehen <span class="btn-arrow">&rarr;</span>';
        errEl.textContent = (window.__lpErr ? window.__lpErr('Etwas ist schiefgelaufen. Bitte versuch es nochmal.') : 'Etwas ist schiefgelaufen. Bitte versuch es nochmal.');
        errEl.hidden = false;
      });
    }
  </script>

  <script is:inline>
    // Regler: zeigt, was ein angespanntes Nervensystem mit dem Körper macht
    (function () {
      var inp = document.getElementById('rIn');
      if (!inp) return;
      var STUFEN = [
        { bis: 33, name: 'Ruhe', text: 'Dein Körper fühlt sich sicher. Er gibt Energie frei, der Hunger kommt und geht. So kann Abnehmen funktionieren.' },
        { bis: 66, name: 'Anspannung', text: 'Das Stresshormon Cortisol steigt. Du schläfst unruhiger, am Nachmittag kommt der Heisshunger. Dein Körper fängt an festzuhalten.' },
        { bis: 100, name: 'Daueralarm', text: 'Dein Körper ist im Schutzmodus. Er hält Reserven fest, vor allem am Bauch. Abends sucht dein Nervensystem Ruhe im Essen. Keine Diät kommt dagegen an.' }
      ];
      var gemeldet = false;
      function stufe(v) { for (var i = 0; i < STUFEN.length; i++) if (v <= STUFEN[i].bis) return STUFEN[i]; return STUFEN[2]; }
      function setze() {
        var v = +inp.value, s = stufe(v);
        var fest = Math.round(15 + v * 0.8), hunger = Math.round(10 + v * 0.85), kraft = Math.round(95 - v * 0.8);
        document.getElementById('rName').textContent = s.name;
        document.getElementById('rText').textContent = s.text;
        [['m1', fest], ['m2', hunger], ['m3', kraft]].forEach(function (m) {
          document.getElementById(m[0]).style.width = m[1] + '%';
          document.getElementById(m[0] + 't').textContent = m[1] < 35 ? 'niedrig' : m[1] < 65 ? 'mittel' : 'hoch';
        });
        document.getElementById('regler').dataset.stufe = s.name;
        inp.style.setProperty('--v', v + '%');
      }
      inp.addEventListener('input', function () {
        setze();
        if (!gemeldet && window.__lp) { gemeldet = true; window.__lp.track('regler_used', { page: 'nervensystem' }, 'fot', 'Nervensystem-Check'); }
      });
      setze();
    })();

    // Drei Muster als Tabs
    function tab(k) {
      ['a', 'l', 'x'].forEach(function (x) {
        document.getElementById('tb-' + x).setAttribute('aria-selected', x === k ? 'true' : 'false');
        document.getElementById('tp-' + x).hidden = x !== k;
      });
    }

    // Atemübung: 6 Runden, 4 Sekunden ein, 6 Sekunden aus
    var atemTimer = null;
    function atem() {
      var btn = document.getElementById('aBtn'), kreis = document.getElementById('aKreis');
      var txt = document.getElementById('aText'), zahl = document.getElementById('aZahl'), runde = document.getElementById('aRunde');
      if (atemTimer) { clearInterval(atemTimer); atemTimer = null; kreis.className = 'atem-kreis'; txt.textContent = 'Bereit?'; zahl.textContent = ''; btn.textContent = 'Übung starten'; runde.textContent = '6 Runden · 1 Minute'; return; }
      if (window.__lp) window.__lp.track('atem_start', { page: 'nervensystem' }, 'fot', 'Nervensystem-Check');
      btn.textContent = 'Stopp';
      var r = 1, phase = 'ein', rest = 4;
      function zeig() {
        kreis.className = 'atem-kreis ' + (phase === 'ein' ? 'is-ein' : 'is-aus');
        txt.textContent = phase === 'ein' ? 'Einatmen' : 'Ausatmen';
        zahl.textContent = rest;
        runde.textContent = 'Runde ' + r + ' von 6';
      }
      zeig();
      atemTimer = setInterval(function () {
        rest--;
        if (rest > 0) { zahl.textContent = rest; return; }
        if (phase === 'ein') { phase = 'aus'; rest = 6; }
        else if (r < 6) { r++; phase = 'ein'; rest = 4; }
        else {
          clearInterval(atemTimer); atemTimer = null;
          kreis.className = 'atem-kreis is-fertig'; txt.textContent = 'Gut gemacht'; zahl.textContent = '';
          runde.textContent = 'Spürst du den Unterschied? Genau da setzt dein Ergebnis an.';
          btn.textContent = 'Nochmal';
          return;
        }
        zeig();
      }, 1000);
    }

    function zumStart() { window.scrollTo({ top: 0, behavior: 'smooth' }); }
  </script>

  <script is:inline src="https://t.hyros.com/v1/lst/universal-script?ph=689a71ca1ab3be1cb1caddbe6b7902a4ad2c51a228f4ec9ea7fef3123a705f63"></script>

