---
// VSL-Call-Funnel "Schilddrüsen-Analyse", Schritt 1: Opt-in mit maximalem Proof
// Redesign 20.08.2026 (Philipp): eigenes Design in FoT-CI (Inter, #4584EE, Navy-Hero),
// Desktop-first mit 2-Spalten-Hero, voll responsive, swipebare Video- und Bild-Testimonials.
// Proof-Quellen: 24 YouTube-Erfolgsgeschichten (fitontime.ch), Vorher-Nachher-Collagen,
// Beweis-Stack aus voice.md (4.000+ / 97% / 94% / 9 kg / 14 kg / Krankenkassen-anerkannt).
// Flow: Opt-in (3 Fragen + Formular) → /schilddruesen-analyse/danke (VSL + Termin)
import CookieBanner from '../../components/CookieBanner.astro';

const LP_SLUG = 'schilddruesen-analyse';
const LP_NAME = 'Schilddrüsen-Analyse VSL Funnel';
const PIXEL_ID = (import.meta.env.PUBLIC_META_PIXEL_ID || '').trim();
const HYROS_ID = (import.meta.env.PUBLIC_HYROS_ID || '').trim();
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-955413991').trim();
const IMPRESSUM_URL = 'https://fitontime.ch/impressum-datenschutz';
const DATENSCHUTZ_URL = 'https://fitontime.ch/impressum-datenschutz';

// Video-Erfolgsgeschichten (YouTube, gleiche Quellen wie fitontime.ch Erfolgsgeschichten-Seite)
const VIDEO_IDS = ['WNswBZ1uLAg','ylw-p5gOiYs','BMcN-2Ic3AY','V_ysJXCMA8s','UQD6KPnVgvE','Ro-nrECseYk','IwFxPM0saBY','UM5acAVXx4E','14ishTYBYjU'];

// Vorher-Nachher-Collagen (öffentlich gepostetes Material, gebrandet)
const TF_IMAGES = Array.from({ length: 12 }, (_, i) => `/images/sd-proof/tf-${String(i + 1).padStart(2, '0')}.jpg`);
---
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Werte in Ordnung, Gewicht nicht? | Fit on Time</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Hyros First-Party-Attribution, lädt ohne Consent (analog zu allen FOT-Funnels) -->
  <script is:inline src="https://t.hyros.com/v1/lst/universal-script?ph=689a71ca1ab3be1cb1caddbe6b7902a4ad2c51a228f4ec9ea7fef3123a705f63"></script>

  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0b2244;
      --navy-2: #123059;
      --blue: #4584ee;
      --blue-dark: #2f6ad0;
      --lightblue: #eef7ff;
      --blush: #fff1ee;
      --peach: #f5c3b7;
      --green: #22c55e;
      --amber: #f59e0b;
      --red: #ef4444;
      --text: #10203a;
      --text-2: #44546e;
      --text-3: #8a97a8;
      --line: #e3eaf4;
      --r: 14px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --shadow: 0 10px 34px rgba(11,34,68,0.10);
    }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body { font-family: var(--font); background: #fff; color: var(--text); line-height: 1.5; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    img { max-width: 100%; display: block; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

    /* ===== Topbar ===== */
    .topbar { background: #fff; border-bottom: 1px solid var(--line); }
    .topbar-in { max-width: 1120px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .topbar img { height: 34px; }
    .topbar .kk { font-size: 12px; font-weight: 700; color: var(--text-2); display: inline-flex; align-items: center; gap: 7px; }
    .topbar .kk .dot { color: var(--green); }

    /* ===== Hero (Navy) ===== */
    .hero { background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 58%, #1a3f74 100%); color: #fff; padding: 44px 0 84px; position: relative; }
    .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 44px; align-items: start; }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; padding: 7px 14px; font-size: 12.5px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: var(--peach); margin-bottom: 18px; }
    .hero h1 { font-size: 42px; font-weight: 900; line-height: 1.12; letter-spacing: -1px; margin-bottom: 16px; }
    .hero h1 em { font-style: normal; color: #8ab5ff; }
    .hero .sub { font-size: 17px; color: #c7d6ee; line-height: 1.6; margin-bottom: 22px; max-width: 560px; }
    .hero .sub strong { color: #fff; font-weight: 700; }

    .proof-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .proof-avatars { display: flex; }
    .proof-avatars img { width: 38px; height: 38px; border-radius: 50%; border: 2px solid var(--navy); margin-left: -11px; object-fit: cover; object-position: center 28%; }
    .proof-avatars img:first-child { margin-left: 0; }
    .proof-info { font-size: 13px; color: #c7d6ee; line-height: 1.35; }
    .proof-info b { color: #fff; }
    .proof-stars { color: var(--amber); font-size: 13px; letter-spacing: 1.5px; }

    .hero-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .hbadge { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.16); border-radius: 999px; padding: 8px 14px; font-size: 12.5px; font-weight: 600; color: #dfe9f8; }

    .hero-cta-mobile { display: none; }

    /* ===== Gate-Card (im Hero rechts, mobil darunter) ===== */
    .gate-card { background: #fff; color: var(--text); border-radius: 18px; box-shadow: 0 24px 70px rgba(4,12,28,0.45); padding: 26px 24px; }
    .gc-kicker { font-size: 11.5px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; color: var(--blue); margin-bottom: 6px; }
    .gc-title { font-size: 21px; font-weight: 800; line-height: 1.25; letter-spacing: -0.3px; margin-bottom: 8px; }
    .gc-why { background: var(--lightblue); border-radius: 10px; padding: 11px 13px; font-size: 13px; color: var(--text-2); line-height: 1.5; margin-bottom: 16px; }
    .gc-why strong { color: var(--text); }

    .gate-prog { font-size: 11px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
    .gate-prog .bar { flex: 1; height: 5px; background: var(--line); border-radius: 999px; overflow: hidden; }
    .gate-prog .fill { height: 100%; width: 33%; background: var(--blue); border-radius: 999px; transition: width 0.25s; }
    .gate-q { font-size: 16.5px; font-weight: 800; margin-bottom: 3px; line-height: 1.3; }
    .gate-hint { font-size: 12.5px; color: var(--text-3); margin-bottom: 13px; }
    .gate-step { display: none; }
    .gate-step.on { display: block; }
    .gate-opts { display: flex; flex-direction: column; gap: 8px; }
    .gate-opt { background: #fff; border: 2px solid var(--line); border-radius: 12px; padding: 13px 15px; font: inherit; font-size: 14.5px; font-weight: 600; color: var(--text); text-align: left; cursor: pointer; transition: all 0.15s; -webkit-tap-highlight-color: transparent; }
    .gate-opt:hover { border-color: var(--blue); transform: translateY(-1px); }
    .gate-opt.selected { border-color: var(--blue); background: var(--lightblue); }
    .gate-back { display: block; margin: 12px auto 0; background: none; border: none; font: inherit; font-size: 12.5px; color: var(--text-3); cursor: pointer; }

    .optin-part { display: none; }
    .optin-part.on { display: block; }
    .optin-part h2 { font-size: 17px; font-weight: 800; margin-bottom: 4px; }
    .optin-part .oc-sub { font-size: 12.5px; color: var(--text-3); margin-bottom: 13px; }
    form.optin { display: flex; flex-direction: column; gap: 10px; }
    form.optin input { width: 100%; padding: 14px 16px; font: inherit; font-size: 16px; border: 2px solid var(--line); border-radius: 12px; background: #fff; color: var(--text); }
    form.optin input:focus { outline: none; border-color: var(--blue); }
    .btn { display: block; width: 100%; background: var(--blue); color: #fff; border: none; border-radius: 999px; padding: 16px 26px; font: inherit; font-size: 16.5px; font-weight: 800; cursor: pointer; transition: all 0.2s; box-shadow: 0 8px 22px rgba(69,132,238,0.38); text-align: center; text-decoration: none; -webkit-tap-highlight-color: transparent; }
    .btn:hover { background: var(--blue-dark); transform: translateY(-1px); }
    .btn:active { transform: scale(0.98); }
    .btn[disabled] { opacity: 0.6; cursor: wait; transform: none; }
    .privacy-note { font-size: 10.5px; color: var(--text-3); text-align: center; line-height: 1.45; }
    .privacy-note a { color: var(--text-3); }
    .err { display: none; font-size: 13px; color: var(--red); text-align: center; font-weight: 600; }
    .err.show { display: block; }
    .gc-video-points { margin-top: 14px; border-top: 1px solid var(--line); padding-top: 13px; display: flex; flex-direction: column; gap: 8px; }
    .gc-point { display: flex; gap: 9px; font-size: 12.5px; color: var(--text-2); line-height: 1.45; }
    .gc-point .ic { color: var(--green); font-weight: 800; flex-shrink: 0; }
    .gc-point strong { color: var(--text); }

    /* ===== Stats-Band ===== */
    .stats-band { background: #fff; margin-top: -46px; position: relative; z-index: 2; }
    .stats-in { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
    .stats-card { background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); display: grid; grid-template-columns: repeat(5, 1fr); overflow: hidden; }
    .stat { padding: 20px 10px; text-align: center; border-left: 1px solid var(--line); }
    .stat:first-child { border-left: 0; }
    .stat-num { font-size: 27px; font-weight: 900; color: var(--blue); letter-spacing: -0.7px; line-height: 1; }
    .stat-label { font-size: 11px; color: var(--text-3); margin-top: 6px; font-weight: 600; line-height: 1.3; }

    /* ===== Sections ===== */
    section.block { padding: 56px 0 30px; }
    .sec-kicker { font-size: 12px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; color: var(--blue); text-align: center; margin-bottom: 8px; }
    .sec-title { font-size: 32px; font-weight: 900; text-align: center; letter-spacing: -0.7px; line-height: 1.15; margin-bottom: 8px; }
    .sec-sub { font-size: 15px; color: var(--text-2); text-align: center; margin-bottom: 26px; max-width: 620px; margin-left: auto; margin-right: auto; }

    /* ===== Carousel (Swipe) ===== */
    .car-shell { position: relative; }
    .carousel { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 20px 18px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .carousel::-webkit-scrollbar { display: none; }
    .car-item { scroll-snap-align: start; flex-shrink: 0; }
    .car-nav { position: absolute; top: 50%; transform: translateY(-60%); width: 44px; height: 44px; border-radius: 50%; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--text); font-size: 18px; font-weight: 800; cursor: pointer; z-index: 3; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .car-nav:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
    .car-nav.prev { left: 6px; }
    .car-nav.next { right: 6px; }
    .swipe-hint { display: none; text-align: center; font-size: 12px; color: var(--text-3); margin-top: 2px; }

    /* Video-Cards */
    .vid-card { width: 340px; border-radius: 16px; overflow: hidden; background: var(--navy); position: relative; aspect-ratio: 16 / 9; cursor: pointer; box-shadow: var(--shadow); }
    .vid-card img.thumb { width: 100%; height: 100%; object-fit: cover; opacity: 0.92; transition: transform 0.3s, opacity 0.2s; }
    .vid-card:hover img.thumb { transform: scale(1.04); opacity: 1; }
    .vid-card .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
    .vid-card .play span { width: 58px; height: 58px; border-radius: 50%; background: rgba(255,255,255,0.94); color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 21px; padding-left: 4px; box-shadow: 0 8px 24px rgba(0,0,0,0.35); transition: transform 0.15s; }
    .vid-card:hover .play span { transform: scale(1.08); }
    .vid-card iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .vid-card .tag { position: absolute; left: 10px; bottom: 10px; background: rgba(11,34,68,0.82); color: #fff; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 5px 11px; }

    /* Vorher/Nachher-Cards */
    .tf-card { width: 265px; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
    .tf-card img { width: 100%; aspect-ratio: 1; object-fit: cover; }

    /* ===== Named Testimonials ===== */
    .named { background: var(--lightblue); }
    .named-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding-bottom: 26px; }
    .named-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 18px; box-shadow: var(--shadow); }
    .named-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; margin-bottom: 12px; }
    .named-stars { color: var(--amber); font-size: 12px; letter-spacing: 1.5px; margin-bottom: 6px; }
    .named-quote { font-size: 14.5px; color: var(--text); font-weight: 600; line-height: 1.5; margin-bottom: 8px; }
    .named-meta { font-size: 12px; color: var(--text-3); font-weight: 600; }

    /* ===== Video-Teaser (Was dich im Video erwartet) ===== */
    .teaser { background: var(--navy); color: #fff; border-radius: 22px; padding: 40px 36px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 34px; align-items: center; }
    .teaser h2 { font-size: 27px; font-weight: 900; letter-spacing: -0.5px; line-height: 1.2; margin-bottom: 12px; }
    .teaser h2 em { font-style: normal; color: #8ab5ff; }
    .teaser p.tz { font-size: 14.5px; color: #c7d6ee; line-height: 1.6; margin-bottom: 18px; }
    .teaser .btn { max-width: 340px; }
    .teaser-list { display: flex; flex-direction: column; gap: 12px; }
    .tl-item { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-radius: 12px; padding: 13px 15px; display: flex; gap: 11px; font-size: 14px; color: #dfe9f8; line-height: 1.5; }
    .tl-item .num { width: 24px; height: 24px; border-radius: 50%; background: var(--blue); color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .tl-item strong { color: #fff; }

    /* ===== Ablauf + Versprechen ===== */
    .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 14px; }
    .step-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 20px; box-shadow: var(--shadow); }
    .step-num { width: 30px; height: 30px; border-radius: 50%; background: var(--blue); color: #fff; font-size: 14px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }
    .step-card h3 { font-size: 15.5px; font-weight: 800; margin-bottom: 6px; }
    .step-card p { font-size: 13.5px; color: var(--text-2); line-height: 1.55; }
    .no-pressure { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 14px; padding: 16px 18px; font-size: 14px; color: var(--text-2); line-height: 1.6; max-width: 760px; margin: 0 auto; }
    .no-pressure strong { color: var(--text); }

    /* ===== FAQ ===== */
    .faq { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
    .faq details { background: #fff; border: 1px solid var(--line); border-radius: 12px; }
    .faq summary { list-style: none; cursor: pointer; padding: 15px 17px; font-size: 14.5px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; gap: 10px; -webkit-tap-highlight-color: transparent; }
    .faq summary::after { content: '+'; font-size: 19px; color: var(--text-3); font-weight: 400; }
    .faq details[open] summary::after { content: '-'; }
    .faq .faq-a { padding: 0 17px 15px; font-size: 13.5px; color: var(--text-2); line-height: 1.6; }

    /* ===== Final CTA ===== */
    .final { background: var(--blush); }
    .final-in { text-align: center; padding-bottom: 40px; }
    .final .btn { max-width: 380px; margin: 0 auto; }
    .final-note { font-size: 12.5px; color: var(--text-3); margin-top: 12px; }

    footer { padding: 30px 16px 26px; text-align: center; color: var(--text-3); font-size: 11.5px; line-height: 1.6; background: #fff; border-top: 1px solid var(--line); }
    footer a { color: var(--text-3); }
    .disclaimer { max-width: 680px; margin: 0 auto 10px; font-size: 10.5px; color: #aab6c4; }

    /* ===== Responsive ===== */
    @media (max-width: 900px) {
      .hero { padding: 30px 0 76px; }
      .hero-grid { grid-template-columns: 1fr; gap: 26px; }
      .hero h1 { font-size: 30px; }
      .stats-card { grid-template-columns: repeat(3, 1fr); }
      .stat { border-left: 0; border-top: 1px solid var(--line); }
      .stat:nth-child(-n+3) { border-top: 0; }
      .stat:nth-child(3n+2), .stat:nth-child(3n) { border-left: 1px solid var(--line); }
      .named-grid { grid-template-columns: 1fr; }
      .teaser { grid-template-columns: 1fr; padding: 28px 22px; }
      .steps-grid { grid-template-columns: 1fr; }
      .sec-title { font-size: 25px; }
      .car-nav { display: none; }
      .swipe-hint { display: block; }
      .vid-card { width: 82vw; max-width: 340px; }
      .tf-card { width: 62vw; max-width: 265px; }
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-in">
      <img src="/images/logo.png" alt="Fit on Time" />
      <span class="kk"><span class="dot">●</span> Krankenkassen-anerkanntes Coaching</span>
    </div>
  </div>

  <!-- ===== Hero mit Gate-Card ===== -->
  <header class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Für Frauen, die alles für andere tun, nur nichts für sich</span>
          <h1>Deine Werte sind in Ordnung, aber du nimmst trotzdem nicht ab? Genau da haben <em>über 4.000 Frauen</em> bei uns angefangen.</h1>
          <p class="sub">Im kostenlosen Video zeigen wir dir <strong>den genauen Ablauf bei Fit on Time</strong>: warum dein Körper das Fett festhält, und warum unsere Methode bei Frauen funktioniert, bei denen vorher <strong>nichts mehr funktioniert</strong> hat.</p>
          <div class="proof-bar">
            <div class="proof-avatars">
              <img src="/images/transformations/t1.jpg" alt="" /><img src="/images/transformations/t2.jpg" alt="" /><img src="/images/transformations/t3.jpg" alt="" /><img src="/images/transformations/t4.jpg" alt="" />
            </div>
            <div class="proof-info"><span class="proof-stars">★★★★★</span><br /><b>4.000+ Frauen</b> in der Schweiz begleitet</div>
          </div>
          <div class="hero-badges">
            <span class="hbadge">Ø 9 kg nach 6 Monaten</span>
            <span class="hbadge">97% erreichen ihr Ziel</span>
            <span class="hbadge">94% halten es nach 12 Monaten</span>
          </div>
        </div>

        <div class="gate-card" id="gate">
          <p class="gc-kicker">Kostenloses Video</p>
          <p class="gc-title">Der Ablauf hinter über 4.000 Transformationen</p>
          <p class="gc-why"><strong>Warum 3 Fragen?</strong> Deine Antworten gehen an unser Coaching-Team. So wissen wir, wo du stehst, bevor du das Video siehst, und können dir danach eine ehrliche Einschätzung geben statt einer Standard-Antwort.</p>

          <div id="gateSteps">
            <p class="gate-prog"><span id="gateProgTxt">Frage 1 von 3</span><span class="bar"><span class="fill" id="gateFill"></span></span></p>

            <div class="gate-step on" data-g="1">
              <p class="gate-q">Kommt dir das bekannt vor?</p>
              <p class="gate-hint">Wähl aus, was am ehesten auf dich zutrifft.</p>
              <div class="gate-opts">
                <button class="gate-opt" onclick="gnxt(1,this,'werte-ok')">Beim Arzt heisst es, alles in Ordnung. Aber ich nehme trotzdem nicht ab</button>
                <button class="gate-opt" onclick="gnxt(1,this,'muede-kalt')">Ich bin ständig müde und mir ist oft kalt</button>
                <button class="gate-opt" onclick="gnxt(1,this,'wenig-essen')">Ich esse wenig und die Waage bewegt sich trotzdem nicht</button>
                <button class="gate-opt" onclick="gnxt(1,this,'alles')">Ehrlich gesagt alles davon</button>
              </div>
            </div>

            <div class="gate-step" data-g="2">
              <p class="gate-q">Was hast du bisher schon probiert?</p>
              <p class="gate-hint">Damit wir dir nicht erzählen, was du längst hinter dir hast.</p>
              <div class="gate-opts">
                <button class="gate-opt" onclick="gnxt(2,this,'diaeten')">Diäten und Kalorienzählen</button>
                <button class="gate-opt" onclick="gnxt(2,this,'sport')">Sport und mehr Bewegung</button>
                <button class="gate-opt" onclick="gnxt(2,this,'arzt')">Ich war deswegen schon beim Arzt</button>
                <button class="gate-opt" onclick="gnxt(2,this,'alles')">Ehrlich gesagt alles davon</button>
              </div>
              <button class="gate-back" onclick="gback(1)">&larr; Zurück</button>
            </div>

            <div class="gate-step" data-g="3">
              <p class="gate-q">Wie schnell willst du etwas ändern?</p>
              <p class="gate-hint">Letzte Frage, danach schalten wir dein Video frei.</p>
              <div class="gate-opts">
