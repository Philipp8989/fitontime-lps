  <script is:inline define:vars={{ LP_SLUG, LP_NAME }}>
    const SESSION_KEY = 'fot_session';
    let session = sessionStorage.getItem(SESSION_KEY);
    if (!session) {
      session = (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now());
      sessionStorage.setItem(SESSION_KEY, session);
    }

    function track(event, extra) {
      const payload = JSON.stringify(Object.assign({ event, lp: LP_SLUG, lp_name: LP_NAME, session }, extra || {}));
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
          return;
        }
      } catch (e) {}
      fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
    }

    track('page_view', { page: 'optin' });

    window.__scrollGate = function () {
      document.getElementById('gate').scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    // ===== Mikro-Gate: 3 Qualifizierungsfragen vor dem Formular =====
    const GATE_TOTAL = 3;
    const gateAnswers = {};

    function gshow(s) {
      document.querySelectorAll('.gate-step').forEach((el) => el.classList.remove('on'));
      const t = document.querySelector('.gate-step[data-g="' + s + '"]');
      if (t) t.classList.add('on');
      document.getElementById('gateProgTxt').textContent = 'Frage ' + s + ' von ' + GATE_TOTAL;
      document.getElementById('gateFill').style.width = Math.round((s / GATE_TOTAL) * 100) + '%';
    }

    function gback(s) {
      gshow(s);
      window.__scrollGate();
    }

    function gnxt(s, el, val) {
      gateAnswers['g' + s] = val;
      if (el) el.classList.add('selected');
      track('gate_answer', { step: s, detail: val });

      setTimeout(() => {
        if (s < GATE_TOTAL) {
          gshow(s + 1);
          window.__scrollGate();
          return;
        }
        // Gate durch: Formular freischalten
        document.getElementById('gateSteps').style.display = 'none';
        document.getElementById('optinCard').classList.add('on');
        track('gate_complete');
        if (window.__lp) window.__lp.meta('ViewContent', { content_name: 'FoT SD-Analyse Gate Complete', currency: 'CHF' });
        window.__scrollGate();
      }, 180);
    }

    window.gnxt = gnxt;
    window.gback = gback;

    // Feld-Fortschritt ohne PII: welche Felder ausgefüllt wurden, nicht deren Inhalt
    document.querySelectorAll('#optinForm input').forEach((el) => {
      el.addEventListener('blur', () => {
        if (el.value.trim()) track('field_filled', { field: el.name });
      }, { once: true });
    });

    const form = document.getElementById('optinForm');
    const btn = document.getElementById('submitBtn');
    const err = document.getElementById('formErr');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.remove('show');
      const fd = new FormData(form);
      const name = (fd.get('fname') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim();
      const phone = (fd.get('phone') || '').toString().trim();
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || phone.replace(/\D/g, '').length < 7) {
        err.classList.add('show');
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Einen Moment …';
      try {
        const res = await fetch('/api/sheets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, lp_slug: LP_SLUG, lp_name: LP_NAME, session, answers: gateAnswers }),
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          throw new Error(j.error || 'Fehler beim Senden');
        }
        track('lead_submit');
        if (window.__lp) window.__lp.meta('Lead', { content_name: 'FoT SD-Analyse Lead', currency: 'CHF' });
        if (window.__lp) window.__lp.google('generate_lead', 'j12JCMr5-9UcEOfryccD');
        sessionStorage.setItem('fot_sda_lead', JSON.stringify({ name: name.split(' ')[0], email }));
        window.location.href = '/schilddruesen-analyse/danke';
      } catch (ex) {
        btn.disabled = false;
        btn.textContent = 'Ja, zeig mir das Video →';
        err.textContent = 'Das hat leider nicht geklappt. Bitte versuch es nochmal.';
        err.classList.add('show');
      }
    });

    // ===== Carousels: Pfeile (Desktop) + Swipe (nativ per scroll-snap) =====
    document.querySelectorAll('.car-nav').forEach((b) => {
      b.addEventListener('click', () => {
        const car = document.getElementById(b.dataset.car);
        const item = car.querySelector('.car-item');
        const w = item ? item.getBoundingClientRect().width + 14 : 320;
        car.scrollBy({ left: Number(b.dataset.dir) * w * 2, behavior: 'smooth' });
      });
    });

    // ===== Video-Testimonials: Click-to-play (YouTube nocookie, lädt erst beim Klick) =====
    document.querySelectorAll('.vid-card').forEach((card) => {
      card.addEventListener('click', () => {
        if (card.dataset.played) return;
        card.dataset.played = '1';
        const id = card.dataset.vid;
        track('testimonial_video_play', { detail: id });
        const f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
        f.allow = 'autoplay; encrypted-media; fullscreen';
        f.allowFullscreen = true;
        f.title = 'Erfolgsgeschichte';
        card.innerHTML = '';
        card.appendChild(f);
      });
    });

    // ===== Motion-Layer: Tilt, Parallax, Reveals, Count-up, 3D-Schalter =====
    const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Gate-Card 3D-Tilt mit Glare (nur Maus-Geraete)
    if (fineHover && !reduced) {
      const card = document.querySelector('.gate-card');
      const zone = document.querySelector('.tilt-zone');
      let raf = null;
      zone.addEventListener('mousemove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.classList.add('tilting');
          card.style.transform = 'rotateY(' + ((px - 0.5) * 7).toFixed(2) + 'deg) rotateX(' + ((0.5 - py) * 6).toFixed(2) + 'deg) translateZ(6px)';
          card.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
          card.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
          raf = null;
        });
      });
      zone.addEventListener('mouseleave', () => {
        card.classList.remove('tilting');
        card.style.transform = '';
      });

      // Hero-Orbs Parallax
      const orbs = document.querySelectorAll('.orb');
      const hero = document.querySelector('.hero');
      let oraf = null;
      hero.addEventListener('mousemove', (e) => {
        if (oraf) return;
        oraf = requestAnimationFrame(() => {
          const cx = (e.clientX / window.innerWidth - 0.5);
          const cy = (e.clientY / window.innerHeight - 0.5);
          orbs.forEach((o, i) => {
            const f = (i + 1) * 14;
            o.style.transform = 'translate3d(' + (cx * f) + 'px,' + (cy * f) + 'px,0)';
          });
          oraf = null;
        });
      });

      // Magnetic Buttons (dezent)
      document.querySelectorAll('.btn').forEach((b) => {
        b.addEventListener('mousemove', (e) => {
          const r = b.getBoundingClientRect();
          b.style.transform = 'translate(' + ((e.clientX - r.left - r.width / 2) * 0.08).toFixed(1) + 'px,' + ((e.clientY - r.top - r.height / 2) * 0.18).toFixed(1) + 'px) translateY(-1px)';
        });
        b.addEventListener('mouseleave', () => { b.style.transform = ''; });
      });
    }

    // Scroll-Reveal + Count-up
    if (!reduced && 'IntersectionObserver' in window) {
      const rvEls = [];
      document.querySelectorAll('.sec-kicker, .sec-title, .sec-sub, .named-card, .step-card, .teaser, .no-pressure, .faq details, .sw-stage').forEach((el) => { el.classList.add('rv'); rvEls.push(el); });
      document.querySelectorAll('.stats-card .stat').forEach((el, i) => { el.classList.add('rv'); el.style.setProperty('--d', (i * 0.08) + 's'); rvEls.push(el); });
      document.querySelectorAll('.named-grid .named-card').forEach((el, i) => el.style.setProperty('--d', (i * 0.1) + 's'));
      document.querySelectorAll('.steps-grid .step-card').forEach((el, i) => el.style.setProperty('--d', (i * 0.1) + 's'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      rvEls.forEach((el) => io.observe(el));

      // Count-up der Stat-Zahlen
      const cio = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          cio.unobserve(en.target);
          en.target.querySelectorAll('.stat-num').forEach((el) => {
            const m = el.textContent.match(/^([0-9.']+)(\+?)$/);
            if (!m) return;
            const target = parseInt(m[1].replace(/[.']/g, ''), 10);
            if (!target || target < 10) return;
            const suffix = m[2];
            const fmt = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            const t0 = performance.now();
            const dur = 1400;
            const step = (t) => {
              const pr = Math.min((t - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - pr, 3);
              el.textContent = fmt(Math.round(target * eased)) + suffix;
              if (pr < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        });
      }, { threshold: 0.4 });
      const sc = document.querySelector('.stats-card');
      if (sc) cio.observe(sc);
    }

    // 3D-Schalter
    const sw = document.getElementById('sw3d');
    if (sw) {
      const msg = document.getElementById('swMsg');
      const knob = document.getElementById('swKnob');
      const flip = () => {
        if (sw.classList.contains('on')) return;
        sw.classList.add('on');
        knob.textContent = '🔥';
        msg.innerHTML = 'Dein Schalter steht auf <b class="grn">Verbrennen</b>. Genau dahin bringen wir deinen Körper. <a href="#gate">Schau dir im Video an, wie &rarr;</a>';
        track('schalter_umgelegt');
        if (navigator.vibrate) navigator.vibrate(40);
      };
      sw.addEventListener('click', flip);
      sw.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
      if (fineHover && !reduced) {
        let sraf = null;
        sw.addEventListener('mousemove', (e) => {
          if (sraf) return;
          sraf = requestAnimationFrame(() => {
            const r = sw.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            sw.style.transform = 'rotateY(' + ((px - 0.5) * 14).toFixed(2) + 'deg) rotateX(' + ((0.5 - py) * 12).toFixed(2) + 'deg)';
            sraf = null;
          });
        });
        sw.addEventListener('mouseleave', () => { sw.style.transform = ''; });
      }
    }
  </script>
</body>
</html>
