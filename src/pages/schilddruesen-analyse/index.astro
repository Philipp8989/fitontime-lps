          <div class="proof-bar">
            <div class="proof-avatars">
              <img src="/images/transformations/t1.jpg" alt="" /><img src="/images/transformations/t2.jpg" alt="" /><img src="/images/transformations/t3.jpg" alt="" /><img src="/images/transformations/t4.jpg" alt="" />
            </div>
            <div class="proof-info"><span class="proof-stars">★★★★★</span><br />Genau an diesem Punkt haben<br /><b>über 4.000 Frauen</b> bei uns angefangen</div>
          </div>
          <div class="hero-badges">
            <span class="hbadge">Über 100 dokumentierte Transformationen</span>
            <span class="hbadge">Echte Coaches statt Standardprogramm</span>
          </div>
        </div>

        <div class="tilt-zone"><div class="gate-card" id="gate">
