---
// VSL-Call-Funnel "Schilddrüsen-Analyse", Schritt 1: Opt-in mit maximalem Trust-Stack
// Anlass: Filip 20.08.2026, Vertrauenskomponente fehlt im Funnel. Diese LP stapelt
// alle verifizierten Trust-Anker: Zahlen-Story, Vorher-Nachher, Zitate, Ablauf-Transparenz.
// Flow: Opt-in (3 Fragen + Formular) → /schilddruesen-analyse/danke (VSL + Termin)
import CookieBanner from '../../components/CookieBanner.astro';

const LP_SLUG = 'schilddruesen-analyse';
const LP_NAME = 'Schilddrüsen-Analyse VSL Funnel';
const PIXEL_ID = (import.meta.env.PUBLIC_META_PIXEL_ID || '').trim();
const HYROS_ID = (import.meta.env.PUBLIC_HYROS_ID || '').trim();
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-955413991').trim();
const IMPRESSUM_URL = 'https://fitontime.ch/impressum-datenschutz';
const DATENSCHUTZ_URL = 'https://fitontime.ch/impressum-datenschutz';
---
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Werte in Ordnung, Gewicht nicht? | Fit on Time</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Hyros First-Party-Attribution, lädt ohne Consent (analog zu allen FOT-Funnels) -->
  <script is:inline src="https://t.hyros.com/v1/lst/universal-script?ph=689a71ca1ab3be1cb1caddbe6b7902a4ad2c51a228f4ec9ea7fef3123a705f63"></script>

  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #fafaf8;
      --surface: #f0ebe0;
      --accent: #2b7de9;
      --accent-dark: #1a5bb8;
      --green: #22c55e;
      --amber: #f59e0b;
      --red: #ef4444;
      --text: #1a1a1a;
      --text-2: #4a4a4a;
      --text-3: #888;
      --r: 14px;
      --font: 'DM Sans', system-ui, -apple-system, sans-serif;
    }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); line-height: 1.5; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    .wrap { max-width: 680px; margin: 0 auto; padding: 0 20px; }

    .logo { text-align: center; padding: 16px 0 8px; }
    .logo img { height: 40px; }

    .eyebrow { font-size: 13px; text-transform: uppercase; letter-spacing: 1px; color: var(--red); font-weight: 700; text-align: center; margin: 10px 0 10px; }

    .hero { text-align: center; padding: 4px 0 8px; }
    .hero h1 { font-size: 27px; font-weight: 800; line-height: 1.22; letter-spacing: -0.5px; margin-bottom: 14px; }
    .hero h1 em { font-style: normal; color: var(--accent); }
    .hero .sub { font-size: 16px; color: var(--text-2); margin-bottom: 6px; line-height: 1.5; }
    .hero .sub strong { color: var(--text); font-weight: 700; }

    .proof-bar { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 12px 0 4px; flex-wrap: wrap; }
    .proof-avatars { display: flex; }
    .proof-avatars img { width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--bg); margin-left: -10px; object-fit: cover; object-position: center 30%; }
    .proof-avatars img:first-child { margin-left: 0; }
    .proof-info { font-size: 12px; color: var(--text-3); line-height: 1.3; text-align: left; }
    .proof-info b { color: var(--text); }
    .proof-stars { color: var(--amber); font-size: 12px; letter-spacing: 1px; }

    /* Trust-Badges direkt unter dem Hero */
    .badges { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin: 10px 0 4px; }
    .badge { background: #fff; border: 1px solid #e8e4da; border-radius: 999px; padding: 7px 13px; font-size: 11.5px; font-weight: 700; color: var(--text-2); display: inline-flex; align-items: center; gap: 6px; }
    .badge .dot { color: var(--green); }

    /* Mikro-Gate: 3 Qualifizierungsfragen vor dem Formular (Muster ab-40) */
    .gate { background: #fff; border: 1px solid #e8e4da; border-radius: var(--r); padding: 22px 20px; margin: 18px 0 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .gate-prog { font-size: 11px; color: var(--text-3); text-align: center; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 12px; }
    .gate-q { font-size: 17px; font-weight: 800; text-align: center; margin-bottom: 4px; line-height: 1.3; }
    .gate-hint { font-size: 12.5px; color: var(--text-3); text-align: center; margin-bottom: 16px; }
    .gate-step { display: none; }
    .gate-step.on { display: block; }
    .gate-opts { display: flex; flex-direction: column; gap: 9px; }
    .gate-opt { background: #fff; border: 2px solid #e8e4da; border-radius: 12px; padding: 15px 16px; font: inherit; font-size: 15.5px; font-weight: 600; color: var(--text); text-align: left; cursor: pointer; transition: all 0.15s; -webkit-tap-highlight-color: transparent; }
    .gate-opt:hover { border-color: var(--accent); transform: translateY(-1px); }
    .gate-opt.selected { border-color: var(--accent); background: #f0f6ff; }
    .gate-back { display: block; margin: 14px auto 0; background: none; border: none; font: inherit; font-size: 13px; color: var(--text-3); cursor: pointer; }

    .optin-card { display: none; background: #fff; border: 1px solid #e8e4da; border-radius: var(--r); padding: 24px 20px; margin: 18px 0 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .optin-card.on { display: block; }
    .optin-card h2 { font-size: 17px; font-weight: 800; text-align: center; margin-bottom: 4px; }
    .optin-card .oc-sub { font-size: 13px; color: var(--text-3); text-align: center; margin-bottom: 16px; }
    form.optin { display: flex; flex-direction: column; gap: 12px; }
    form.optin input[type=text], form.optin input[type=email], form.optin input[type=tel] { width: 100%; padding: 15px 18px; font: inherit; font-size: 16px; border: 2px solid #e8e4da; border-radius: 12px; background: #fff; color: var(--text); }
    form.optin input:focus { outline: none; border-color: var(--accent); }
    .btn { display: block; width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 999px; padding: 17px 28px; font: inherit; font-size: 17px; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(43,125,233,0.3); -webkit-tap-highlight-color: transparent; }
    .btn:hover { background: var(--accent-dark); transform: translateY(-1px); }
    .btn:active { transform: scale(0.98); }
    .btn[disabled] { opacity: 0.6; cursor: wait; transform: none; }
    .privacy-note { font-size: 11px; color: var(--text-3); text-align: center; line-height: 1.45; }
    .privacy-note a { color: var(--text-3); }
    .err { display: none; font-size: 13px; color: var(--red); text-align: center; font-weight: 600; }
    .err.show { display: block; }

    .bullets { margin: 22px 0 6px; display: flex; flex-direction: column; gap: 10px; }
    .bullet { background: #fff; border: 1px solid #e8e4da; border-radius: 12px; padding: 14px 16px; display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; color: var(--text-2); line-height: 1.5; }
    .bullet .ic { color: var(--green); font-weight: 800; flex-shrink: 0; }
    .bullet strong { color: var(--text); font-weight: 700; }

    .sec-title { font-size: 20px; font-weight: 800; text-align: center; margin: 28px 0 4px; letter-spacing: -0.3px; }
    .sec-sub { font-size: 13px; color: var(--text-3); text-align: center; margin-bottom: 14px; }

    .trans-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
    .trans-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; background: #fff; }
    .trans-cap { font-size: 11px; color: var(--text-3); text-align: center; margin-top: 8px; }

    /* Erfolgsgeschichte (Coco, aus dem freigegebenen VSL-Deck) */
    .story { background: #fff; border: 1px solid #e8e4da; border-radius: var(--r); padding: 20px; margin: 16px 0; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .story .story-kicker { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: var(--accent); margin-bottom: 6px; }
    .story .story-quote { font-size: 15px; color: var(--text); line-height: 1.55; font-weight: 500; margin-bottom: 8px; }
    .story .story-meta { font-size: 12px; color: var(--text-3); }

    .testis { display: flex; flex-direction: column; gap: 10px; margin: 14px 0; }
    .testi { background: #fff; border: 1px solid #e8e4da; border-radius: 12px; padding: 14px; }
    .testi-stars { color: var(--amber); font-size: 11px; letter-spacing: 1px; margin-bottom: 4px; }
    .testi-quote { font-size: 13.5px; color: var(--text-2); line-height: 1.55; margin-bottom: 6px; }
    .testi-quote strong { color: var(--text); font-weight: 700; }
    .testi-name { font-size: 11px; color: var(--text-3); font-weight: 600; }

    .stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin: 18px 0; }
    .stat { background: #fff; border: 1px solid #e8e4da; border-radius: 12px; padding: 14px 6px; text-align: center; }
    .stat .stat-num { font-size: 24px; font-weight: 800; color: var(--accent); letter-spacing: -0.5px; line-height: 1; }
    .stat .stat-label { font-size: 10px; color: var(--text-3); margin-top: 5px; text-transform: uppercase; letter-spacing: 0.3px; font-weight: 600; }

    /* Ablauf-Transparenz: nimmt die Angst vor dem "Verkaufsgespräch" */
    .steps { display: flex; flex-direction: column; gap: 10px; margin: 14px 0; }
    .step-card { background: #fff; border: 1px solid #e8e4da; border-radius: 12px; padding: 14px 16px; display: flex; gap: 12px; align-items: flex-start; }
    .step-num { width: 26px; height: 26px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
    .step-card p { font-size: 14px; color: var(--text-2); line-height: 1.5; }
    .step-card strong { color: var(--text); }
    .no-pressure { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 14px 16px; font-size: 13.5px; color: var(--text-2); line-height: 1.55; margin: 10px 0; }
    .no-pressure strong { color: var(--text); }

    /* FAQ */
    .faq { margin: 14px 0 6px; display: flex; flex-direction: column; gap: 8px; }
    .faq details { background: #fff; border: 1px solid #e8e4da; border-radius: 12px; padding: 0; }
    .faq summary { list-style: none; cursor: pointer; padding: 14px 16px; font-size: 14px; font-weight: 700; display: flex; justify-content: space-between; align-items: center; -webkit-tap-highlight-color: transparent; }
    .faq summary::after { content: '+'; font-size: 18px; color: var(--text-3); font-weight: 400; }
    .faq details[open] summary::after { content: '-'; }
    .faq .faq-a { padding: 0 16px 14px; font-size: 13.5px; color: var(--text-2); line-height: 1.55; }

    .cta-repeat { text-align: center; margin: 12px 0 26px; }
    .cta-repeat a { display: inline-block; background: var(--accent); color: #fff; text-decoration: none; border-radius: 999px; padding: 16px 34px; font-size: 16px; font-weight: 700; box-shadow: 0 4px 14px rgba(43,125,233,0.3); }

    footer { padding: 26px 16px 22px; text-align: center; color: var(--text-3); font-size: 11.5px; line-height: 1.6; }
    footer a { color: var(--text-3); }
    .disclaimer { max-width: 640px; margin: 0 auto 10px; font-size: 10.5px; color: #aaa; }

    @media (max-width: 480px) {
      .hero h1 { font-size: 23px; }
    }
  </style>
</head>
<body>
  <div class="logo"><img src="/images/logo.png" alt="Fit on Time" /></div>

  <main class="wrap">
    <p class="eyebrow">Für Frauen, die alles für andere tun, nur nichts für sich</p>

    <section class="hero">
      <h1>Deine Werte sind in Ordnung, aber dein Gewicht nicht? Schau dir an, wie <em>über 4.000 Frauen</em> in der Schweiz wieder abgenommen haben. Ohne noch eine Diät.</h1>
      <p class="sub">Beantworte <strong>3 kurze Fragen</strong> und du siehst direkt das kostenlose Video von unseren <strong>Ernährungs- und Fitness-Coaches</strong>. Darin erfährst du, warum dein Körper das Fett festhält, und was bei Frauen wie dir wirklich funktioniert hat.</p>
    </section>

    <div class="proof-bar">
      <div class="proof-avatars">
        <img src="/images/transformations/t1.jpg" alt="" /><img src="/images/transformations/t2.jpg" alt="" /><img src="/images/transformations/t3.jpg" alt="" /><img src="/images/transformations/t4.jpg" alt="" />
      </div>
      <div class="proof-info"><span class="proof-stars">★★★★★</span><br /><b>4.000+ Frauen</b> in der Schweiz begleitet</div>
    </div>

    <div class="badges">
      <span class="badge"><span class="dot">●</span> Krankenkassen-anerkanntes Coaching</span>
      <span class="badge"><span class="dot">●</span> 45'000+ Analysen ausgewertet</span>
      <span class="badge"><span class="dot">●</span> Echte Coaches, kein Programm</span>
    </div>

    <div class="gate" id="gate">
      <p class="gate-prog" id="gateProg">Frage 1 von 3</p>

      <div class="gate-step on" data-g="1">
        <p class="gate-q">Kommt dir das bekannt vor?</p>
        <p class="gate-hint">Wähl aus, was am ehesten auf dich zutrifft.</p>
        <div class="gate-opts">
          <button class="gate-opt" onclick="gnxt(1,this,'werte-ok')">Beim Arzt heisst es, alles in Ordnung. Aber ich nehme trotzdem nicht ab</button>
          <button class="gate-opt" onclick="gnxt(1,this,'muede-kalt')">Ich bin ständig müde und mir ist oft kalt</button>
          <button class="gate-opt" onclick="gnxt(1,this,'wenig-essen')">Ich esse wenig und die Waage bewegt sich trotzdem nicht</button>
          <button class="gate-opt" onclick="gnxt(1,this,'alles')">Ehrlich gesagt alles davon</button>
        </div>
      </div>

      <div class="gate-step" data-g="2">
        <p class="gate-q">Was hast du bisher schon probiert?</p>
        <p class="gate-hint">Damit wir dir nicht erzählen, was du längst hinter dir hast.</p>
        <div class="gate-opts">
          <button class="gate-opt" onclick="gnxt(2,this,'diaeten')">Diäten und Kalorienzählen</button>
          <button class="gate-opt" onclick="gnxt(2,this,'sport')">Sport und mehr Bewegung</button>
          <button class="gate-opt" onclick="gnxt(2,this,'arzt')">Ich war deswegen schon beim Arzt</button>
          <button class="gate-opt" onclick="gnxt(2,this,'alles')">Ehrlich gesagt alles davon</button>
        </div>
        <button class="gate-back" onclick="gback(1)">&larr; Zurück</button>
      </div>

      <div class="gate-step" data-g="3">
        <p class="gate-q">Wie schnell willst du etwas ändern?</p>
        <p class="gate-hint">Letzte Frage, danach startet dein Video.</p>
        <div class="gate-opts">
          <button class="gate-opt" onclick="gnxt(3,this,'sofort')">Sofort, ich habe genug gewartet</button>
          <button class="gate-opt" onclick="gnxt(3,this,'wochen')">In den nächsten Wochen</button>
          <button class="gate-opt" onclick="gnxt(3,this,'info')">Ich will mich erst informieren</button>
        </div>
        <button class="gate-back" onclick="gback(2)">&larr; Zurück</button>
      </div>
    </div>

    <div class="optin-card" id="optinCard">
      <h2>Dein Video ist bereit</h2>
      <p class="oc-sub">Wohin dürfen wir es schicken? Du wirst direkt weitergeleitet.</p>
      <form class="optin" id="optinForm" novalidate>
        <input type="text" name="fname" placeholder="Dein Vorname" autocomplete="given-name" required />
        <input type="email" name="email" placeholder="Deine E-Mail-Adresse" autocomplete="email" required />
        <input type="tel" name="phone" placeholder="Deine Handynummer" autocomplete="tel" required />
        <button class="btn" id="submitBtn" type="submit">Ja, zeig mir das Video →</button>
        <p class="err" id="formErr">Bitte Vorname, eine gültige E-Mail-Adresse und deine Handynummer eintragen.</p>
        <p class="privacy-note">100% kostenlos. Kein Spam. Mit dem Absenden akzeptierst du die <a href={DATENSCHUTZ_URL} target="_blank" rel="noopener">Datenschutzerklärung</a>.</p>
      </form>
    </div>

    <div class="bullets">
      <div class="bullet"><span class="ic">✓</span><span><strong>Warum die Waage stillsteht,</strong> obwohl du wenig isst: was in deinem Körper wirklich passiert, in einfachen Worten erklärt.</span></div>
      <div class="bullet"><span class="ic">✓</span><span><strong>Was deine Schilddrüse damit zu tun hat,</strong> auch wenn deine Blutwerte im Normbereich sind.</span></div>
      <div class="bullet"><span class="ic">✓</span><span><strong>Wie über 4.000 Frauen es geschafft haben:</strong> echte Geschichten, echte Zahlen, kein Wundermittel und keine Spritze.</span></div>
    </div>

    <p class="sec-title">Echte Frauen. Echte Ergebnisse.</p>
    <p class="sec-sub">Ein kleiner Ausschnitt aus über 4.000 Erfolgsgeschichten</p>
    <div class="trans-grid">
      <img src="/images/transformations/schalter-1.jpg" alt="Transformation" loading="lazy" />
      <img src="/images/transformations/schalter-2.jpg" alt="Transformation" loading="lazy" />
      <img src="/images/transformations/schalter-3.jpg" alt="Transformation" loading="lazy" />
      <img src="/images/transformations/t5.jpg" alt="Transformation" loading="lazy" />
      <img src="/images/transformations/t6.jpg" alt="Transformation" loading="lazy" />
      <img src="/images/transformations/t7.jpg" alt="Transformation" loading="lazy" />
    </div>
    <p class="trans-cap">Individuelle Ergebnisse. Resultate hängen von persönlichen Voraussetzungen ab.</p>

    <div class="story">
      <p class="story-kicker">Erfolgsgeschichte</p>
      <p class="story-quote">„Ich dachte jahrelang, ich sei einfach undiszipliniert. Dabei war mein Körper im Schutzmodus. Als ich das verstanden habe, hat sich alles verändert."</p>
      <p class="story-meta">Coco, minus 21 Kilo in 16 Monaten mit dem Fit on Time Coaching</p>
    </div>

    <div class="testis">
      <div class="testi">
        <div class="testi-stars">★★★★★</div>
        <p class="testi-quote">„Ich habe seit den Wechseljahren <strong>alles</strong> probiert. Erst hier habe ich verstanden, warum nichts funktioniert hat. <strong>Minus 9 Kilo</strong>, und ich esse mehr als vorher."</p>
        <p class="testi-name">Teilnehmerin aus dem Fit on Time Coaching</p>
      </div>
      <div class="testi">
        <div class="testi-stars">★★★★★</div>
        <p class="testi-quote">„Keine Verbote, keine Punkte zählen, keine Spritze. Zum ersten Mal fühlt sich abnehmen <strong>nicht wie Kampf</strong> an."</p>
        <p class="testi-name">Teilnehmerin aus dem Fit on Time Coaching</p>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><div class="stat-num">4.000+</div><div class="stat-label">Frauen begleitet</div></div>
      <div class="stat"><div class="stat-num">83%</div><div class="stat-label">erreichen ihr finales Ziel</div></div>
      <div class="stat"><div class="stat-num">77%</div><div class="stat-label">halten es nach 12 Mo.</div></div>
    </div>

    <p class="sec-title">So läuft es ab</p>
    <p class="sec-sub">Kein Kleingedrucktes, keine Überraschungen</p>
    <div class="steps">
      <div class="step-card"><span class="step-num">1</span><p><strong>Du schaust das Video.</strong> Darin erklären dir unsere Coaches, warum dein Körper das Fett festhält und was dagegen hilft. Kostenlos, ohne Anmeldung zu irgendwas.</p></div>
      <div class="step-card"><span class="step-num">2</span><p><strong>Wenn es dich anspricht,</strong> kannst du danach ein kostenloses Gespräch buchen. 30 Minuten, per Telefon oder Zoom, mit einer Coachin aus unserem Team. Kein Callcenter.</p></div>
      <div class="step-card"><span class="step-num">3</span><p><strong>Du entscheidest.</strong> Im Gespräch schauen wir gemeinsam auf deine Situation. Wenn wir dir helfen können, sagen wir dir wie. Wenn nicht, sagen wir dir das genauso ehrlich.</p></div>
    </div>
    <div class="no-pressure"><strong>Unser Versprechen:</strong> Im Gespräch wird dir nichts angedreht. Über 4.000 Frauen haben diesen Weg vor dir gemacht, und er hat nur funktioniert, weil wir nur mit Frauen arbeiten, bei denen es wirklich passt.</div>

    <p class="sec-title">Häufige Fragen</p>
    <div class="faq">
      <details>
        <summary>Kostet mich das etwas?</summary>
        <p class="faq-a">Nein. Das Video und das Gespräch sind kostenlos und verpflichten dich zu nichts. Erst wenn du dich danach für eine Begleitung entscheidest, reden wir über Details.</p>
      </details>
      <details>
        <summary>Muss ich schon wissen, ob meine Schilddrüse betroffen ist?</summary>
        <p class="faq-a">Nein. Genau darum geht es im Video: Du verstehst, welche Rolle die Schilddrüse spielen kann, auch wenn deine Blutwerte im Normbereich sind. Das Video ersetzt keinen Arztbesuch, es hilft dir aber, deinen Körper zu verstehen.</p>
      </details>
      <details>
        <summary>Wer ruft mich an, wenn ich ein Gespräch buche?</summary>
        <p class="faq-a">Eine Coachin aus dem Fit on Time Team in der Schweiz. Kein Callcenter, kein Skript. Sie schaut mit dir gemeinsam auf deine Situation.</p>
      </details>
      <details>
        <summary>Ist das wieder so ein Diät-Programm?</summary>
        <p class="faq-a">Nein. Diäten sind meistens genau der Grund, warum der Stoffwechsel auf Sparen umstellt. Unser Coaching setzt am Gegenteil an: Dein Körper soll wieder verbrennen statt speichern. Deshalb ist das Coaching auch von Schweizer Krankenkassen anerkannt.</p>
      </details>
    </div>

    <div class="cta-repeat"><a href="#gate">Jetzt kostenloses Video ansehen →</a></div>
  </main>

  <footer>
    <p class="disclaimer">Dieses Angebot richtet sich an gesunde Erwachsene. Die gezeigten Ergebnisse sind individuelle Erfahrungen und keine Erfolgsgarantie. Kein Ersatz für ärztliche Beratung oder Diagnose.</p>
    <a href={IMPRESSUM_URL} target="_blank" rel="noopener">Impressum</a> · <a href={DATENSCHUTZ_URL} target="_blank" rel="noopener">Datenschutz</a>
  </footer>

  <CookieBanner
    metaPixelId={PIXEL_ID}
    hyrosPh={HYROS_ID}
    googleAdsId={GOOGLE_ADS_ID}
    impressumUrl={IMPRESSUM_URL}
    datenschutzUrl={DATENSCHUTZ_URL}
    consentKey="fot_consent"
  />

  <script is:inline define:vars={{ LP_SLUG, LP_NAME }}>
    const SESSION_KEY = 'fot_session';
    let session = sessionStorage.getItem(SESSION_KEY);
    if (!session) {
      session = (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now());
      sessionStorage.setItem(SESSION_KEY, session);
    }

    function track(event, extra) {
      const payload = JSON.stringify(Object.assign({ event, lp: LP_SLUG, lp_name: LP_NAME, session }, extra || {}));
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
          return;
        }
      } catch (e) {}
      fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
    }

    track('page_view', { page: 'optin' });

    // ===== Mikro-Gate: 3 Qualifizierungsfragen vor dem Formular =====
    const GATE_TOTAL = 3;
    const gateAnswers = {};

    function gshow(s) {
      document.querySelectorAll('.gate-step').forEach((el) => el.classList.remove('on'));
      const t = document.querySelector('.gate-step[data-g="' + s + '"]');
      if (t) t.classList.add('on');
      document.getElementById('gateProg').textContent = 'Frage ' + s + ' von ' + GATE_TOTAL;
    }

    function gback(s) {
      gshow(s);
      document.getElementById('gate').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function gnxt(s, el, val) {
      gateAnswers['g' + s] = val;
      if (el) el.classList.add('selected');
      track('gate_answer', { step: s, detail: val });

      setTimeout(() => {
        if (s < GATE_TOTAL) {
          gshow(s + 1);
          document.getElementById('gate').scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        // Gate durch: Formular freischalten
        document.getElementById('gate').style.display = 'none';
        document.getElementById('optinCard').classList.add('on');
        track('gate_complete');
        if (window.__lp) window.__lp.meta('ViewContent', { content_name: 'FoT SD-Analyse Gate Complete', currency: 'CHF' });
        document.getElementById('optinCard').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 180);
    }

    window.gnxt = gnxt;
    window.gback = gback;

    // Feld-Fortschritt ohne PII: welche Felder ausgefüllt wurden, nicht deren Inhalt
    document.querySelectorAll('#optinForm input').forEach((el) => {
      el.addEventListener('blur', () => {
        if (el.value.trim()) track('field_filled', { field: el.name });
      }, { once: true });
    });

    const form = document.getElementById('optinForm');
    const btn = document.getElementById('submitBtn');
    const err = document.getElementById('formErr');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.remove('show');
      const fd = new FormData(form);
      const name = (fd.get('fname') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim();
      const phone = (fd.get('phone') || '').toString().trim();
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || phone.replace(/\D/g, '').length < 7) {
        err.classList.add('show');
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Einen Moment …';
      try {
        const res = await fetch('/api/sheets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, lp_slug: LP_SLUG, lp_name: LP_NAME, session, answers: gateAnswers }),
        });
        if (!res.ok) {
          const j = await res.json().catch(() => ({}));
          throw new Error(j.error || 'Fehler beim Senden');
        }
        track('lead_submit');
        if (window.__lp) window.__lp.meta('Lead', { content_name: 'FoT SD-Analyse Lead', currency: 'CHF' });
        if (window.__lp) window.__lp.google('generate_lead', 'j12JCMr5-9UcEOfryccD');
        // Name für die VSL-Seite merken
        sessionStorage.setItem('fot_sda_lead', JSON.stringify({ name: name.split(' ')[0], email }));
        window.location.href = '/schilddruesen-analyse/danke';
      } catch (ex) {
        btn.disabled = false;
        btn.textContent = 'Ja, zeig mir das Video →';
        err.textContent = 'Das hat leider nicht geklappt. Bitte versuch es nochmal.';
        err.classList.add('show');
      }
    });
  </script>
</body>
</html>
