---
// VSL-Call-Funnel "So funktioniert FOT" (bis 27.08.2026: schilddruesen-analyse), Schritt 2: Danke-Seite mit VSL + Terminbuchung
// Redesign 20.08.2026: gleiches Designsystem wie die Opt-in-Seite (Inter, FoT-Blau, Navy-Hero).
// Im Video wird der Ablauf bei Fit on Time erklärt (Loom-VSL, Doc liegt in 02_Ad-Scripts).
// VSL-Env: PUBLIC_FOT_SDA_VSL_URL, Fallback auf das Ab-40-VSL bis das eigene Video steht.
// Hinweis: YCBM leitet nach der Buchung auf /ab-40/bestaetigt weiter (Account-seitig
// konfiguriert), call_booked feuert dort unter dem ab-40-Slug.
import CookieBanner from '../../components/CookieBanner.astro';
import ScaleeeCredit from '../../components/ScaleeeCredit.astro';

const LP_SLUG = 'so-funktioniert-fot';
const LP_NAME = 'So funktioniert FOT (VSL-Funnel)';
const PIXEL_ID = (import.meta.env.PUBLIC_META_PIXEL_ID || '').trim();
const HYROS_ID = (import.meta.env.PUBLIC_HYROS_ID || '').trim();
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-955413991').trim();
const YCBM_DOMAIN = (import.meta.env.PUBLIC_FOT_YCBM_DOMAIN || 'fitontime-analyse-fot-vsl').trim();
const IMPRESSUM_URL = 'https://fitontime.ch/impressum-datenschutz';
const DATENSCHUTZ_URL = 'https://fitontime.ch/impressum-datenschutz';

// Loom-VSL "So funktioniert Fit on Time" (Fabian, final 27.08.2026).
// Env PUBLIC_FOT_SOFU_VSL_URL kann die URL ueberschreiben, sonst gilt der Default.
const VSL_EMBED = (import.meta.env.PUBLIC_FOT_SOFU_VSL_URL || 'https://www.loom.com/embed/ec0400eb6b194892a275e5092e407e87?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true').trim();

const VIDEOS = [
  { id: 'vDO6zqFmKtw', label: 'Abnehmen trotz Schilddrüsen-Unterfunktion' },
  { id: 'WNswBZ1uLAg', label: 'Sara: nach 2 Jahren immer noch in Topform' },
  { id: 'ylw-p5gOiYs', label: 'Angela: knapp 10 Kilo in 5 Monaten' },
  { id: 'UQD6KPnVgvE', label: 'Silvia: mein Leben hat sich verändert' },
  { id: 'wysBi002rbg', label: 'Berufstätige Mutter: 15 Kilo in 7 Monaten' },
  { id: 'CdcU9ZRqjGw', label: 'Muskelaufbau als Frau: einfach wow' },
  { id: 'yc4JF90Hct0', label: 'Nach 10 Jahren endlich das richtige System' },
  { id: '-KMBnLvTaDk', label: '12 Kleidergrössen in 2 Jahren' },
].slice(0, 6);
const TF_IMAGES = Array.from({ length: 12 }, (_, i) => `/images/sd-proof/tf-${String(i + 1).padStart(2, '0')}.jpg`);
---
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Dein Video: Der Ablauf bei Fit on Time | Fit on Time</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script is:inline src="https://t.hyros.com/v1/lst/universal-script?ph=689a71ca1ab3be1cb1caddbe6b7902a4ad2c51a228f4ec9ea7fef3123a705f63"></script>

  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --navy: #0b2244;
      --navy-2: #123059;
      --blue: #4584ee;
      --blue-dark: #2f6ad0;
      --lightblue: #eef7ff;
      --blush: #fff1ee;
      --green: #22c55e;
      --amber: #f59e0b;
      --red: #ef4444;
      --text: #10203a;
      --text-2: #44546e;
      --text-3: #8a97a8;
      --line: #e3eaf4;
      --r: 14px;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --shadow: 0 10px 34px rgba(11,34,68,0.10);
    }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body { font-family: var(--font); background: #fff; color: var(--text); line-height: 1.5; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    img { max-width: 100%; display: block; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
    .narrow { max-width: 840px; margin: 0 auto; padding: 0 20px; }

    .topbar { background: #fff; border-bottom: 1px solid var(--line); }
    .topbar-in { max-width: 1120px; margin: 0 auto; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .topbar img { height: 34px; }
    .topbar .kk { font-size: 12px; font-weight: 700; color: var(--text-2); display: inline-flex; align-items: center; gap: 7px; }
    .topbar .kk .dot { color: var(--green); }

    .vsl-hero { background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 58%, #1a3f74 100%); color: #fff; padding: 34px 0 60px; }
    .vsl-hero .greet { font-size: 13.5px; color: #8ab5ff; margin-bottom: 8px; font-weight: 700; text-align: center; }
    .vsl-hero h1 { font-size: 32px; font-weight: 900; line-height: 1.18; letter-spacing: -0.7px; text-align: center; margin-bottom: 8px; }
    .vsl-hero h1 em { font-style: normal; color: #8ab5ff; }
    .vsl-hero .sub { font-size: 15px; color: #c7d6ee; text-align: center; max-width: 620px; margin: 0 auto 16px; }
    .play-hint { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12.5px; font-weight: 800; color: var(--amber); text-transform: uppercase; letter-spacing: 0.6px; margin: 4px 0 12px; }
    .play-hint .arrow { animation: bounce 1.2s infinite; display: inline-block; }
    @keyframes bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
    .video-shell { position: relative; border-radius: 18px; overflow: hidden; background: #050e1e; aspect-ratio: 16 / 9; box-shadow: 0 26px 70px rgba(2,8,20,0.55); }
    .video-shell iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .video-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #fff; text-align: center; padding: 20px; }
    .video-placeholder .pp { width: 68px; height: 68px; border-radius: 50%; background: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 26px; color: #fff; box-shadow: 0 6px 22px rgba(69,132,238,0.5); }
    .video-placeholder p { font-size: 14px; color: #c7d6ee; max-width: 380px; }

    .cta-card { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 26px 24px; margin: -34px auto 18px; position: relative; z-index: 2; box-shadow: var(--shadow); max-width: 720px; }
    .cta-card h2 { font-size: 20px; font-weight: 900; text-align: center; letter-spacing: -0.3px; margin-bottom: 6px; }
    .cta-card .cc-sub { font-size: 13.5px; color: var(--text-2); text-align: center; margin-bottom: 14px; line-height: 1.55; }
    .qualifier { display: flex; gap: 10px; align-items: flex-start; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; cursor: pointer; }
    .qualifier input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--blue); flex-shrink: 0; cursor: pointer; }
    .qualifier span { font-size: 13.5px; color: var(--text-2); line-height: 1.5; }
    .qualifier strong { color: var(--text); }
    .btn { display: block; width: 100%; background: var(--blue); color: #fff; border: none; border-radius: 999px; padding: 16px 26px; font: inherit; font-size: 16.5px; font-weight: 800; cursor: pointer; transition: all 0.2s; box-shadow: 0 8px 22px rgba(69,132,238,0.38); text-align: center; text-decoration: none; -webkit-tap-highlight-color: transparent; }
    .btn:hover { background: var(--blue-dark); transform: translateY(-1px); }
    .btn.locked { background: #b9c6d8; box-shadow: none; cursor: not-allowed; transform: none; }
    .slots { font-size: 12px; color: var(--text-3); text-align: center; margin-top: 10px; }
    .slots b { color: var(--amber); }
    .no-pressure { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 13px 15px; font-size: 13px; color: var(--text-2); line-height: 1.55; margin-top: 12px; }
    .no-pressure strong { color: var(--text); }

    .cal-sec { display: none; margin: 10px auto 20px; max-width: 840px; padding: 0 20px; }
    .cal-sec.on { display: block; animation: fadeUp 0.45s ease; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .cal-head { text-align: center; margin: 6px 0 10px; }
    .cal-head h2 { font-size: 20px; font-weight: 900; margin-bottom: 4px; }
    .cal-head p { font-size: 13px; color: var(--text-2); }
    .cal-note { font-size: 12px; color: var(--text-3); text-align: center; margin-top: 4px; }
    #ycbmEmbed { min-height: 760px; }

    .stats-card { background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; max-width: 720px; margin: 0 auto 8px; }
    .stat { padding: 18px 8px; text-align: center; border-left: 1px solid var(--line); }
    .stat:first-child { border-left: 0; }
    .stat-num { font-size: 25px; font-weight: 900; color: var(--blue); letter-spacing: -0.6px; line-height: 1; }
    .stat-label { font-size: 10.5px; color: var(--text-3); margin-top: 6px; font-weight: 600; }

    section.block { padding: 40px 0 18px; }
    .sec-kicker { font-size: 12px; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; color: var(--blue); text-align: center; margin-bottom: 8px; }
    .sec-title { font-size: 27px; font-weight: 900; text-align: center; letter-spacing: -0.6px; line-height: 1.18; margin-bottom: 8px; }
    .sec-sub { font-size: 14px; color: var(--text-2); text-align: center; margin-bottom: 22px; max-width: 620px; margin-left: auto; margin-right: auto; }

    .car-shell { position: relative; }
    .carousel { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 20px 18px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .carousel::-webkit-scrollbar { display: none; }
    .car-item { scroll-snap-align: start; flex-shrink: 0; }
    .car-nav { position: absolute; top: 50%; transform: translateY(-60%); width: 44px; height: 44px; border-radius: 50%; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--text); font-size: 18px; font-weight: 800; cursor: pointer; z-index: 3; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .car-nav:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
    .car-nav.prev { left: 6px; }
    .car-nav.next { right: 6px; }
    .swipe-hint { display: none; text-align: center; font-size: 12px; color: var(--text-3); margin-top: 2px; }

    .vid-card { width: 320px; border-radius: 16px; overflow: hidden; background: var(--navy); position: relative; aspect-ratio: 16 / 9; cursor: pointer; box-shadow: var(--shadow); }
    .vid-card img.thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; transition: transform 0.35s ease; }
    .vid-card:hover img.thumb { transform: scale(1.045); }
    .vid-card .vp { position: absolute; inset: 0; padding: 10px 12px; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(180deg, rgba(11,34,68,0.06) 0%, rgba(11,34,68,0) 30%, rgba(11,34,68,0) 68%, rgba(11,34,68,0.82) 100%); }
    .vid-card .vp-center { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
    .vid-card .vp-center .pp { width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.95); color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 19px; padding-left: 4px; box-shadow: 0 10px 28px rgba(0,0,0,0.4); transition: transform 0.15s; }
    .vid-card:hover .vp-center .pp { transform: scale(1.1); }
    .vid-card .vp-bar { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .vp-bar .pt { color: #fff; font-size: 12.5px; font-weight: 700; text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
    .vp-stars { color: var(--amber); font-size: 12px; letter-spacing: 1.5px; text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
    .vid-card .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
    .vid-card .play span { width: 54px; height: 54px; border-radius: 50%; background: rgba(255,255,255,0.94); color: var(--blue); display: flex; align-items: center; justify-content: center; font-size: 20px; padding-left: 4px; box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
    .vid-card iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .vid-card { background: linear-gradient(150deg, #123059 0%, #0b2244 70%); }
    .tf-card { width: 235px; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
    .tf-card img { width: 100%; aspect-ratio: 1; object-fit: cover; }

    .backtop { text-align: center; padding: 8px 0 40px; }
    .backtop .btn { max-width: 380px; margin: 0 auto; }

    footer { padding: 30px 16px 26px; text-align: center; color: var(--text-3); font-size: 11.5px; line-height: 1.6; background: #fff; border-top: 1px solid var(--line); }
    footer a { color: var(--text-3); }
    .disclaimer { max-width: 680px; margin: 0 auto 10px; font-size: 10.5px; color: #aab6c4; }

    @media (max-width: 900px) {
      .vsl-hero h1 { font-size: 24px; }
      .car-nav { display: none; }
      .swipe-hint { display: block; }
      .vid-card { width: 82vw; max-width: 320px; }
      .tf-card { width: 60vw; max-width: 235px; }
      .sec-title { font-size: 22px; }
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-in">
      <img src="/images/logo.png" alt="Fit on Time" />
      <span class="kk"><span class="dot">●</span> Echte Coaches, kein Programm</span>
    </div>
  </div>

  <header class="vsl-hero">
    <div class="narrow">
      <p class="greet" id="greet">Dein Video ist freigeschaltet</p>
      <h1>Warum es nicht an deiner Disziplin liegt, <em>und wie du diesmal wirklich dranbleibst</em></h1>
      <p class="sub">Nimm dir kurz Zeit und schau das Video in Ruhe an. Es zeigt dir, wie körperliche Klarheit, ein alltagstauglicher Plan und echte Begleitung zusammenspielen.</p>
      <p class="play-hint"><span>Drück einfach auf Play</span> <span class="arrow">▼</span></p>
      <div class="video-shell" id="videoShell">
        {VSL_EMBED ? (
          <iframe src={VSL_EMBED} allow="autoplay; fullscreen" allowfullscreen title="Der Ablauf bei Fit on Time"></iframe>
        ) : (
          <div class="video-placeholder">
            <div class="pp">▶</div>
            <p><strong>Video wird gerade produziert.</strong><br />Hier erscheint das Video „Der Ablauf bei Fit on Time".</p>
          </div>
        )}
      </div>
    </div>
  </header>

  <div class="narrow">
    <div class="cta-card" id="cta">
      <h2>Bereit für dein kostenloses Strategiegespräch?</h2>
      <p class="cc-sub">30 bis 45 Minuten mit unserer Strategieberatung, per Telefon oder Zoom. Wir schauen nicht nur auf dein Gewicht, sondern auf deine Situation, deinen Alltag und darauf, was dir bisher gefehlt hat, um dranzubleiben. Kein Callcenter, kein Skript.</p>
      <label class="qualifier">
        <input type="checkbox" id="qualifyCheck" />
        <span><strong>Ja, ich bin bereit, etwas an meiner Situation zu ändern.</strong> Mir ist klar, dass professionelle Begleitung eine Investition in mich ist. Wenn das nicht auf dich zutrifft, buche bitte keinen Termin, die Plätze sind begrenzt.</span>
      </label>
      <button class="btn locked" id="bookBtn">Kostenloses Strategiegespräch sichern →</button>
      <p class="slots">Unser Team führt nur <b>eine begrenzte Zahl an Gesprächen pro Woche</b>.</p>
      <div class="no-pressure"><strong>Unser Versprechen:</strong> Im Gespräch wird dir nichts angedreht. Wenn wir dir helfen können, sagen wir dir wie. Wenn nicht, sagen wir dir das genauso ehrlich.</div>
    </div>
  </div>

  <div class="cal-sec" id="calSec">
    <div class="cal-head">
      <h2>Such dir jetzt deinen Wunschtermin aus</h2>
      <p>Das Gespräch dauert 30 bis 45 Minuten und findet per Telefon oder Zoom statt.</p>
    </div>
    <div id="ycbmEmbed"></div>
    <p class="cal-note">Der Kalender kann einen Moment zum Laden brauchen.</p>
  </div>

  <section class="block">
    <div class="stats-card">
      <div class="stat"><div class="stat-num">4.000+</div><div class="stat-label">Frauen begleitet</div></div>
      <div class="stat"><div class="stat-num">100+</div><div class="stat-label">dokumentierte Transformationen</div></div>
      <div class="stat"><div class="stat-num">1:1</div><div class="stat-label">Begleitung durch echte Coaches</div></div>
    </div>
  </section>

  <section class="block">
    <p class="sec-kicker">Echte Stimmen</p>
    <h2 class="sec-title">Sie alle standen, wo du gerade stehst</h2>
    <p class="sec-sub">Teilnehmerinnen erzählen vor der Kamera, was sich verändert hat.</p>
    <div class="car-shell">
      <button class="car-nav prev" data-car="vidCar" data-dir="-1" aria-label="Zurück">←</button>
      <div class="carousel" id="vidCar">
        {VIDEOS.map((v) => (
          <div class="car-item vid-card" data-vid={v.id}>
            <img class="thumb" src={`/images/sd-videos/${v.id}.webp`} alt={v.label} width="720" height="405" loading="lazy" decoding="async" />
            <div class="vp">
              <div class="vp-center"><span class="pp">▶</span></div>
              <div class="vp-bar">
                <span class="pt">Video abspielen</span>
                <span class="vp-stars">★★★★★</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <button class="car-nav next" data-car="vidCar" data-dir="1" aria-label="Weiter">→</button>
    </div>
    <p class="swipe-hint">← Wischen für mehr →</p>
  </section>

  <section class="block">
    <p class="sec-kicker">Vorher / Nachher</p>
    <h2 class="sec-title">Echte Frauen. Echte Ergebnisse.</h2>
    <p class="sec-sub">Individuelle Ergebnisse. Resultate hängen von persönlichen Voraussetzungen ab.</p>
    <div class="car-shell">
      <button class="car-nav prev" data-car="tfCar" data-dir="-1" aria-label="Zurück">←</button>
      <div class="carousel" id="tfCar">
        {TF_IMAGES.map((src) => (
          <div class="car-item tf-card"><img src={src} alt="Vorher-Nachher-Transformation" loading="lazy" /></div>
        ))}
      </div>
      <button class="car-nav next" data-car="tfCar" data-dir="1" aria-label="Weiter">→</button>
    </div>
    <p class="swipe-hint">← Wischen für mehr →</p>
  </section>

  <div class="backtop">
    <a class="btn" href="#cta">Nach oben zur Terminbuchung ↑</a>
  </div>

  <footer>
    <p class="disclaimer">Die gezeigten Ergebnisse sind individuelle Erfahrungen und keine Erfolgsgarantie. Ergebnisse hängen von persönlichen Voraussetzungen, Ausgangslage und Mitarbeit ab. Kein Ersatz für ärztliche Beratung.</p>
    <a href={IMPRESSUM_URL} target="_blank" rel="noopener">Impressum</a> · <a href={DATENSCHUTZ_URL} target="_blank" rel="noopener">Datenschutz</a>
  <div style="margin-top:10px;text-align:center;"><ScaleeeCredit /></div>
  </footer>

  <CookieBanner
    metaPixelId={PIXEL_ID}
    hyrosPh={HYROS_ID}
    googleAdsId={GOOGLE_ADS_ID}
    impressumUrl={IMPRESSUM_URL}
    datenschutzUrl={DATENSCHUTZ_URL}
    consentKey="fot_consent"
  />

  <script is:inline define:vars={{ LP_SLUG, LP_NAME, YCBM_DOMAIN }}>
    const SESSION_KEY = 'fot_session';
    let session = sessionStorage.getItem(SESSION_KEY);
    if (!session) {
      session = (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2) + Date.now());
      sessionStorage.setItem(SESSION_KEY, session);
    }
    function track(event, extra) {
      const payload = JSON.stringify(Object.assign({ event, lp: LP_SLUG, lp_name: LP_NAME, session }, extra || {}));
      try {
        if (navigator.sendBeacon) { navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' })); return; }
      } catch (e) {}
      fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
    }

    track('page_view', { page: 'vsl' });

    // Persönliche Begrüssung, wenn Opt-in-Daten vorhanden
    try {
      const lead = JSON.parse(sessionStorage.getItem('fot_sda_lead') || 'null');
      if (lead && lead.name) document.getElementById('greet').textContent = lead.name + ', dein Video ist freigeschaltet';
    } catch (e) {}

    // Qualifier-Checkbox schaltet den Termin-Button frei
    const check = document.getElementById('qualifyCheck');
    const bookBtn = document.getElementById('bookBtn');
    const calSec = document.getElementById('calSec');
    let ycbmLoaded = false;

    function loadYcbm() {
      // YouCanBook.me Embed-Script (rendert das Booking-Widget in #ycbmEmbed).
      // data-domain nimmt nur die Subdomain, KEIN Prefill-Query (das würde die URL brechen).
      if (ycbmLoaded) return;
      ycbmLoaded = true;
      // Der Kalender ist mit dem Ab-40-Funnel geteilt und leitet nach der Buchung immer
      // auf /ab-40/bestaetigt. Herkunft merken, damit call_booked dort unter diesem
      // Funnel zaehlt und nicht unter ab-40.
      try { sessionStorage.setItem('fot_booking_lp', JSON.stringify({ slug: LP_SLUG, name: LP_NAME })); } catch (e) {}
      const s = document.createElement('script');
      s.src = 'https://embed.ycb.me';
      s.async = true;
      s.setAttribute('data-domain', YCBM_DOMAIN);
      s.setAttribute('data-displaymode', 'auto');
      document.getElementById('ycbmEmbed').appendChild(s);
    }

    check.addEventListener('change', () => {
      bookBtn.classList.toggle('locked', !check.checked);
      if (check.checked) track('qualifier_checked');
    });

    bookBtn.addEventListener('click', () => {
      if (!check.checked) {
        check.closest('.qualifier').style.outline = '2px solid var(--amber)';
        setTimeout(() => { check.closest('.qualifier').style.outline = 'none'; }, 1200);
        return;
      }
      track('vsl_cta_click');
      calSec.classList.add('on');
      loadYcbm();
      setTimeout(() => { calSec.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 150);
    });

    // Carousels: Pfeile (Desktop) + Swipe (nativ per scroll-snap)
    document.querySelectorAll('.car-nav').forEach((b) => {
      b.addEventListener('click', () => {
        const car = document.getElementById(b.dataset.car);
        const item = car.querySelector('.car-item');
        const w = item ? item.getBoundingClientRect().width + 14 : 320;
        car.scrollBy({ left: Number(b.dataset.dir) * w * 2, behavior: 'smooth' });
      });
    });

    // Video-Testimonials: Click-to-play
    document.querySelectorAll('.vid-card').forEach((card) => {
      card.addEventListener('click', () => {
        if (card.dataset.played) return;
        card.dataset.played = '1';
        const id = card.dataset.vid;
        track('testimonial_video_play', { detail: id });
        const f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
        f.allow = 'autoplay; encrypted-media; fullscreen';
        f.allowFullscreen = true;
        f.title = 'Erfolgsgeschichte';
        card.innerHTML = '';
        card.appendChild(f);
      });
    });
  </script>
</body>
</html>
