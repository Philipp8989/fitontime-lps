---
// Figur-Check, Fassung T "Die Einladung" (13.11.2026). Ziel: Termine im 1:1-Workshop.
// Ablauf: Start, 7 Fragen mit Coach-Rückmeldung, Zwischenergebnis plus Opt-in, persönliche Einladung mit Kalender.
// Traffic kommt nur über den 50/50-Schalter in /figur-check/ (fot_fc_book = T), Ads bleiben auf /figur-check.
// Anschlüsse: Lead über /api/sheets (Slug figur-check-einladung = gleiches Sheet und gleicher Bot-Rahmen wie Figur-Check),
// Kalender YCBM fitontime-workshop, Bestätigung /workshop/gebucht (fot_funnel). Entwurf: Figma FitonTime, Section 8:52.
import '../styles/bauchfett.css';
import CookieBanner from './CookieBanner.astro';
import ScaleeeCredit from './ScaleeeCredit.astro';
import FotWordmark from './FotWordmark.astro';
import ProofPaare from './ProofPaare.astro';

// direkt = Variante B (13.11.2026): kein Opt-in, nach dem Quiz sofort Einladung plus Kalender.
interface Props { direkt?: boolean; }
const { direkt = false } = Astro.props;
const SLUG = direkt ? 'figur-check-einladung-b' : 'figur-check-einladung';
const LP_NAME = direkt ? 'Figur-Check T:Einladung direkt' : 'Figur-Check T:Einladung';

const IMPRESSUM_URL = 'https://fitontime.ch/impressum-datenschutz';
const GOOGLE_ADS_ID = (import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-955413991').trim();
const FONTS = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..500,0..100;1,9..144,300..500,0..100&family=Albert+Sans:wght@400;500;600&display=swap';
const PAARE = ['14', '21', '13', '03', '20', '07', '15', '12', '24', '04'];

// Fragen wie im Figur-Check (gleiche Werte, damit Sheet, Bot und Briefing identisch bleiben).
// Jede Antwort hat eine eigene Rückmeldung der Coach.
const FRAGEN = [
  { q: 'Wie schwer fällt dir Abnehmen, obwohl du auf deine Ernährung achtest?', a: [
    ['extrem', 'Extrem schwer', 'Extrem schwer, obwohl du auf die Ernährung achtest: Dann liegt es selten an der Disziplin. Genau das schauen wir uns an.'],
    ['mittel', 'Es geht so', 'Es geht so heisst oft: viel Aufwand für wenig Ergebnis. Das merken wir uns.'],
    ['leicht', 'Gar nicht schwer', 'Schön. Dann schauen wir, was dich trotzdem hierher gebracht hat.'],
    ['unklar', 'Weiss ich nicht', 'Ehrlich, dass du es nicht weisst. Genau dafür ist der Workshop da.'],
  ] },
  { q: 'Frierst du oft, zum Beispiel kalte Hände oder Füsse?', a: [
    ['staendig', 'Ja, ständig', 'Ständiges Frieren ist eines der häufigsten Zeichen, dass dein Körper Energie spart. Das notieren wir.'],
    ['warm', 'Mir ist eher warm', 'Gut zu wissen. Dann schauen wir genauer auf die anderen Anzeichen.'],
    ['fuesse', 'Oft kalte Füsse', 'Kalte Füsse hören wir oft bei Frauen, deren Stoffwechsel auf Sparflamme läuft.'],
    ['winter', 'Nur im Winter', 'Nur im Winter ist normal. Wir achten auf deine anderen Antworten.'],
  ] },
  { q: 'Wie oft fühlst du dich tagsüber erschöpft?', a: [
    ['fastimmer', 'Fast immer', 'Müde, obwohl du genug schläfst: Das hören wir sehr oft, und es hat selten mit Disziplin zu tun. Wir schauen es uns gemeinsam an.'],
    ['nachmittags', 'Oft am Nachmittag', 'Das Nachmittagstief kennen fast alle Frauen bei uns. Es sagt viel darüber, wie dein Körper mit Energie umgeht.'],
    ['stress', 'Nur nach Stress', 'Erschöpft nach Stress ist ein wichtiger Hinweis. Stress kann das Abnehmen spürbar bremsen.'],
    ['selten', 'Selten', 'Gute Energie ist eine starke Ausgangslage. Das hilft dir später enorm.'],
  ] },
  { q: 'Hast du Wassereinlagerungen, zum Beispiel ein geschwollenes Gesicht?', a: [
    ['sehroft', 'Ja, sehr oft', 'Wassereinlagerungen machen schwer und aufgedunsen, auch wenn das Fett gar nicht mehr wird. Das gehört ins Gesamtbild.'],
    ['gelegentlich', 'Gelegentlich', 'Gelegentlich hängt oft mit dem Zyklus zusammen. Wir schauen es uns im Zusammenhang an.'],
    ['nie', 'Eigentlich nie', 'Gut, ein Punkt weniger auf der Liste.'],
    ['hitze', 'Nur bei Hitze', 'Bei Hitze ist das normal. Kein Grund zur Sorge.'],
  ] },
  { q: 'Wie alt bist du?', a: [
    ['18-29', '18 bis 29 Jahre', 'Je früher du verstehst, wie dein Körper tickt, desto leichter wird es.'],
    ['30-39', '30 bis 39 Jahre', 'In diesem Alter merken viele zum ersten Mal: Was früher klappte, klappt nicht mehr.'],
    ['40-49', '40 bis 49 Jahre', 'Ab 40 verändert sich der Hormonhaushalt. Was mit 30 funktioniert hat, muss angepasst werden.'],
    ['50plus', '50+ Jahre', 'Viele unserer erfolgreichsten Kundinnen sind über 50. Es ist nicht zu spät.'],
  ] },
  { q: 'Wie viel wiegst du momentan?', a: [
    ['u60', 'Weniger als 60 kg', 'Die letzten Kilos sind oft die hartnäckigsten. Auch das lässt sich lösen.'],
    ['60-68', 'Zwischen 60 und 68 kg', 'Gerade hier geht es oft um wenige, aber hartnäckige Kilos.'],
    ['69-77', 'Zwischen 69 und 77 kg', 'Danke. Wichtiger als die Zahl ist, warum sie sich nicht bewegt.'],
    ['ue78', 'Über 78 kg', 'Danke für deine Offenheit. Viele Frauen bei uns sind genau hier gestartet.'],
  ] },
  { q: 'Was hast du schon probiert?', a: [
    ['diaeten', 'Diäten', 'Diäten bringen den Körper oft noch tiefer in den Sparmodus. Darum wird es danach meist schwerer.'],
    ['sport', 'Sport-Programme', 'Viel Sport und trotzdem kein Ergebnis: ein klares Zeichen, dass etwas anderes bremst.'],
    ['nem', 'Nahrungsergänzung', 'Pulver und Pillen lösen selten das eigentliche Problem. Gut, dass du jetzt genauer hinschaust.'],
    ['nichts', 'Noch nichts davon', 'Dann startest du ohne Ballast. Das ist ein Vorteil.'],
  ] },
];
const ABLAUF = [
  { t: 'Deine Situation', d: 'Du erzählst, was du schon versucht hast und wo es hängt.' },
  { t: 'Mögliche Zusammenhänge', d: 'Wir schauen, was bei dir bremsen könnte.' },
  { t: 'Dein nächster Schritt', d: 'Du gehst mit einem klaren, sinnvollen nächsten Schritt aus dem Gespräch.' },
];
const ZAHLEN = [['4\'000+', 'Frauen in der Schweiz begleitet'], ['97 %', 'erreichen ihr Ziel'], ['94 %', 'halten es nach 12 Monaten']];
---
<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Was bremst dich wirklich beim Abnehmen? | Fit on Time</title>
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={FONTS} rel="stylesheet" />
  <script is:inline src="https://t.hyros.com/v1/lst/universal-script?ph=689a71ca1ab3be1cb1caddbe6b7902a4ad2c51a228f4ec9ea7fef3123a705f63"></script>
  <script is:inline data-slug={SLUG}>
    // Fassung merken (Schalter in /figur-check/) und Funnel-Marker für /workshop/gebucht
    try { localStorage.setItem('fot_fc_book', 'T'); sessionStorage.setItem('fot_fc_book', 'T'); sessionStorage.setItem('fot_funnel', document.currentScript.dataset.slug); } catch (e) {}
  </script>
  <style is:global>
    .ek { --w: 75rem; }
    .ek-wrap { max-width: var(--w); margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }
    .ek-kopf { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 0; border-bottom: var(--hairline); }
    .ek-tag, .ek-kicker, .ek-mono { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
    .ek-tag { color: var(--ink-soft); }
    .ek-kicker { color: var(--gold); }
    .ek-soft { color: var(--ink-soft); }
    .ek-step[hidden] { display: none !important; }

    /* Start */
    .ek-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-top: 2rem; padding-bottom: 2.5rem; }
    .ek-hero h1 { font-size: clamp(2.5rem, 7.6vw, 4.75rem); margin: 0.9rem 0 1.1rem; }
    .ek-lead { font-size: 1.06rem; line-height: 1.55; color: var(--ink-soft); max-width: 36rem; text-wrap: pretty; }
    .ek-preis { margin: 1.1rem 0 1.4rem; font-weight: 500; font-variant-numeric: tabular-nums; }
    .ek-preis s { color: var(--taupe); margin-right: 0.6rem; }
    .ek-gate-label { margin-bottom: 0.6rem; color: var(--ink-soft); }
    .ek-gate { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; max-width: 26rem; }
    .ek-btn { font: inherit; font-weight: 600; font-size: 1.02rem; padding: 1rem; border-radius: 4px; cursor: pointer; border: 1px solid var(--ink); background: transparent; color: var(--ink); transition: background-color .15s, color .15s; }
    .ek-btn--voll { background: var(--ink); color: var(--cream-bright); }
    .ek-btn:hover { background: #3a322a; color: var(--cream-bright); }
    .ek-btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .ek-beleg { font-size: 0.86rem; color: var(--ink-soft); margin-top: 1rem; }

    /* Zahlen */
    .ek-zahlen { display: grid; grid-template-columns: repeat(3, 1fr); }
    .ek-zahlen div { border-top: var(--hairline); padding: 0.9rem 0.6rem 0 0; }
    .ek-zahlen b { display: block; font-family: var(--font-display); font-weight: 320; font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.1; font-variant-numeric: tabular-nums; }
    .ek-zahlen span { display: block; font-size: 0.8rem; line-height: 1.35; color: var(--ink-soft); margin-top: 0.25rem; }

    /* Beweis */
    .ek-beweis { background: var(--cream-bright); border-top: var(--hairline); border-bottom: var(--hairline); padding: 2.5rem 0 2.75rem; }
    .ek-beweis h2 { margin: 0.8rem 0 1.4rem; font-size: clamp(1.8rem, 4.4vw, 2.75rem); }
    .ek-beweis-kopf { display: grid; gap: 1.5rem; margin-bottom: 1.75rem; }
    .ek-zitat { border-top: 1px solid var(--gold); padding-top: 1rem; }
    .ek-zitat q { display: block; quotes: '«' '»'; font-family: var(--font-display); font-style: italic; font-weight: 320; font-size: clamp(1.25rem, 2.4vw, 1.5rem); line-height: 1.32; font-variation-settings: "opsz" 110, "SOFT" 70; }
    .ek-zitat cite { display: block; font-style: normal; margin-top: 0.7rem; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
    .ek-zitate { display: grid; gap: 1.5rem; margin-top: 1.75rem; }

    /* Einladungskarte */
    .ek-karte { background: var(--cream-bright); border: 1px solid var(--gold); padding: 6px; box-shadow: var(--shadow-soft); }
    .ek-karte-innen { border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); padding: 1.4rem 1.3rem 1.2rem; }
    .ek-karte-kopf { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
    .ek-karte-kopf .ek-kicker { font-size: 0.62rem; }
    .ek-karte-kopf i { font-family: var(--font-display); font-size: 0.85rem; color: var(--ink-soft); }
    .ek-karte-name { font-family: var(--font-display); font-style: italic; font-weight: 320; font-size: 1.9rem; line-height: 1.15; margin-top: 0.9rem; }
    .ek-karte-intro { font-size: 0.94rem; color: var(--ink-soft); }
    .ek-karte-ws { font-family: var(--font-display); font-weight: 300; font-size: clamp(2.3rem, 6vw, 2.75rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0.15rem 0 1rem; }
    .ek-karte dl { display: grid; grid-template-columns: 4.6rem 1fr; }
    .ek-karte dt, .ek-karte dd { border-top: var(--hairline); padding: 0.7rem 0; }
    .ek-karte dt { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); padding-top: 0.85rem; }
    .ek-karte dd { font-weight: 500; font-size: 0.94rem; }
    .ek-karte dd s { color: var(--taupe); font-weight: 400; margin-right: 0.5rem; }

    /* Quiz */
    .ek-quiz { max-width: 38rem; margin: 0 auto; padding-top: 1.5rem; padding-bottom: 3rem; }
    .ek-prog { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 0.9rem; }
    .ek-prog i { height: 2px; background: color-mix(in srgb, var(--ink) 12%, transparent); }
    .ek-prog i.an { background: var(--gold); }
    .ek-quiz h2 { font-size: clamp(1.75rem, 5vw, 2.4rem); margin: 1.6rem 0 0.4rem; }
    .ek-hinweis { font-size: 0.9rem; color: var(--ink-soft); margin-bottom: 1.1rem; }
    .ek-opts { list-style: none; border-bottom: var(--hairline); }
    .ek-opt { display: grid; grid-template-columns: 1.4rem 1fr auto; gap: 0.75rem; align-items: center; width: 100%; padding: 1.05rem 0.25rem; background: none; border: 0; border-top: var(--hairline); text-align: left; font: inherit; font-weight: 500; font-size: 1.05rem; color: var(--ink); cursor: pointer; transition: background-color .15s, padding .15s; }
    .ek-opt:hover, .ek-opt:focus-visible { background: var(--cream-bright); padding-left: 0.65rem; padding-right: 0.65rem; }
    .ek-opt:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
    .ek-opt .bu { font-size: 0.75rem; color: var(--gold); letter-spacing: 0.08em; }
    .ek-opt .pf { color: var(--gold); }
    .ek-opt.gewaehlt { background: var(--cream-bright); padding-left: 0.65rem; padding-right: 0.65rem; }
    .ek-feedback { margin-top: 1.3rem; min-height: 5.5rem; }
    .ek-feedback p { font-family: var(--font-display); font-style: italic; font-weight: 320; font-size: 1.2rem; line-height: 1.38; margin-top: 0.4rem; font-variation-settings: "opsz" 110, "SOFT" 70; }
    .ek-feedback .ek-weiter { margin-top: 0.8rem; background: none; border: 0; padding: 0; font: inherit; font-size: 0.9rem; color: var(--ink-soft); text-decoration: underline; cursor: pointer; }
    .ek-mini { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding: 0.9rem 1rem; background: var(--cream-bright); border: 1px solid color-mix(in srgb, var(--gold) 70%, transparent); }
    .ek-mini small { display: block; font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); font-weight: 500; }
    .ek-mini span { font-size: 0.9rem; font-weight: 500; }
    .ek-punkte { display: flex; gap: 4px; flex-shrink: 0; }
    .ek-punkte i { width: 6px; height: 6px; border-radius: 50%; background: color-mix(in srgb, var(--ink) 15%, transparent); }
    .ek-punkte i.an { background: var(--gold); }

    /* Formular */
    .ek-zwischen { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; background: var(--cream-bright); border: 1px solid var(--gold); padding: 1rem 1.1rem; margin: 1.2rem 0 1.5rem; }
    .ek-zwischen b { font-family: var(--font-display); font-weight: 300; font-size: 2.6rem; line-height: 1; color: var(--gold); font-variant-numeric: tabular-nums; }
    .ek-zwischen p { font-size: 0.92rem; line-height: 1.45; }
    .ek-felder { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .ek-feld { display: grid; gap: 0.35rem; }
    .ek-feld--breit { grid-column: 1 / -1; }
    .ek-feld label { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; }
    .ek-feld input { width: 100%; font: inherit; font-size: 1rem; color: var(--ink); background: var(--cream-bright); border: 1px solid var(--sand-deep); border-radius: 3px; padding: 0.85rem 0.9rem; }
    .ek-feld input:focus { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
    .ek-check { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; font-size: 0.8rem; line-height: 1.45; color: var(--ink-soft); margin-top: 0.9rem; }
    .ek-check input { width: 1.05rem; height: 1.05rem; margin-top: 0.12rem; accent-color: var(--ink); }
    .ek-check a { color: inherit; }
    .ek-senden { width: 100%; margin-top: 1.1rem; }
    .ek-fehler { display: none; background: #f6e3dc; color: var(--rust); border-radius: 3px; padding: 0.75rem 0.9rem; font-size: 0.9rem; margin-top: 0.9rem; }
    .ek-fehler.show { display: block; }
    .ek-klein { text-align: center; font-size: 0.84rem; color: var(--ink-soft); margin-top: 0.8rem; }

    /* Einladung */
    .ek-einl { padding-top: 1.75rem; padding-bottom: 3rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .ek-einl > div { min-width: 0; }
    .ek-embed { overflow: hidden; }
    .ek-einl h1 { font-size: clamp(2.2rem, 6.4vw, 3.4rem); margin: 0.8rem 0 1.3rem; }
    .ek-muster { list-style: none; border-bottom: var(--hairline); margin-bottom: 1rem; }
    .ek-muster li { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0.7rem; border-top: var(--hairline); padding: 0.85rem 0; font-size: 1rem; line-height: 1.45; }
    .ek-muster li::before { content: counter(m, decimal-leading-zero); counter-increment: m; font-size: 0.75rem; color: var(--gold); padding-top: 0.2rem; }
    .ek-muster { counter-reset: m; }
    #e-h1.ohne-name .e-h1-name { display: none; }
    .ek-deutung { color: var(--ink-soft); line-height: 1.55; text-wrap: pretty; }
    .ek-darum { font-family: var(--font-display); font-style: italic; font-weight: 320; font-size: 1.4rem; margin: 1.5rem 0 1rem; }
    .ek-zusage h2 { font-size: clamp(1.8rem, 4.6vw, 2.6rem); margin: 0.7rem 0 0.5rem; }
    .ek-embed { min-height: 34rem; margin-top: 1.1rem; background: var(--cream-bright); border: var(--hairline); border-radius: 3px; }
    .ek-warum { background: color-mix(in srgb, var(--sand) 55%, transparent); padding: 1.4rem 1.3rem; margin-top: 1.75rem; }
    .ek-warum h3 { margin: 0.5rem 0 0.5rem; }
    .ek-warum p { color: var(--ink-soft); font-size: 0.98rem; line-height: 1.55; }
    .ek-ablauf ol { list-style: none; counter-reset: s; border-bottom: var(--hairline); margin-top: 1rem; }
    .ek-ablauf li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.6rem; border-top: var(--hairline); padding: 1.1rem 0; counter-increment: s; }
    .ek-ablauf li::before { content: counter(s); font-family: var(--font-display); font-weight: 300; font-size: 2rem; line-height: 1; color: var(--gold); }
    .ek-ablauf b { display: block; font-weight: 600; }
    .ek-ablauf span { color: var(--ink-soft); font-size: 0.96rem; }
    .ek-geschenk { display: grid; gap: 0.4rem; margin-top: 1.5rem; color: var(--ink-soft); font-size: 0.96rem; }
    .ek-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--cream) 94%, transparent); border-top: var(--hairline); transform: translateY(110%); transition: transform .2s var(--ease-out); }
    .ek-sticky.zeigen { transform: none; }
    .ek-sticky .ek-btn { width: 100%; }
    .ek-fuss { background: color-mix(in srgb, var(--sand) 55%, transparent); padding: 1.6rem 0 6rem; font-size: 0.78rem; line-height: 1.5; color: var(--ink-soft); }
    .ek-fuss a { color: inherit; }

    @media (min-width: 60rem) {
      .ek-hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 5rem; align-items: center; padding-top: 5.5rem; padding-bottom: 5rem; }
      .ek-lead { font-size: 1.2rem; }
      .ek-beweis { padding: 4.5rem 0; }
      .ek-beweis-kopf { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: end; gap: 5rem; }
      .ek-zitate { grid-template-columns: 1fr 1fr 1fr; gap: 2.5rem; }
      .ek-einl { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 5rem; padding-top: 4rem; padding-bottom: 5rem; align-items: start; }
      .ek-links { position: sticky; top: 1.5rem; }
      .ek-sticky { display: none; }
      .ek-fuss { padding-bottom: 2rem; }
    }
    @media (prefers-reduced-motion: reduce) { .ek-opt, .ek-btn, .ek-sticky { transition: none; } }
  </style>
</head>
<body class="ek" data-slug={SLUG} data-lpname={LP_NAME} data-direkt={direkt ? '1' : '0'}>
  <div class="ek-wrap"><header class="ek-kopf"><FotWordmark /><span class="ek-tag" id="kopf-tag">1:1-Workshop</span></header></div>

  <!-- ===== 1 Start ===== -->
  <section class="ek-step" id="s-start">
    <div class="ek-wrap ek-hero">
      <div>
        <p class="ek-kicker">Figur-Check · 7 Fragen · 90 Sekunden</p>
        <h1>Was bremst dich <em>wirklich beim Abnehmen?</em></h1>
        <p class="ek-lead">Beantworte 7 Fragen. Daraus stellen wir dir eine persönliche Einladung aus: zu deinem 1:1-Workshop, in dem eine Coach deine Antworten mit dir durchgeht.</p>
        <p class="ek-preis"><s>CHF 500</s>Für dich CHF 0</p>
        <p class="ek-mono ek-gate-label">Ich bin</p>
        <div class="ek-gate">
          <button type="button" class="ek-btn ek-btn--voll" data-gender="frau">Frau</button>
          <button type="button" class="ek-btn" data-gender="mann">Mann</button>
        </div>
        <p class="ek-beleg">Über 4'000 Frauen in der Schweiz begleitet. Seit 2016.</p>
      </div>
      <div>
        <p class="ek-mono ek-soft" style="margin-bottom:0.9rem">So sieht deine Einladung am Ende aus</p>
        <div class="ek-karte" aria-hidden="true"><div class="ek-karte-innen">
          <div class="ek-karte-kopf"><span class="ek-kicker">Persönliche Einladung</span><i>Fit on Time</i></div>
          <p class="ek-karte-name">Dein Name,</p>
          <p class="ek-karte-intro">du bist eingeladen zu deinem</p>
          <p class="ek-karte-ws">1:1-Workshop</p>
          <dl><dt>Thema</dt><dd>Ergibt sich aus deinen Antworten</dd><dt>Format</dt><dd>Online, nur du und deine Coach</dd><dt>Termin</dt><dd>Wählst du gleich selbst</dd><dt>Wert</dt><dd><s>CHF 500</s>CHF 0 für dich</dd></dl>
        </div></div>
      </div>
    </div>
    <section class="ek-beweis" aria-labelledby="beweis-h">
      <div class="ek-wrap">
        <div class="ek-beweis-kopf">
          <div><p class="ek-kicker">Echte Kundinnen, echte Fotos</p><h2 id="beweis-h">Über 4'000 Frauen haben diesen Weg <em>schon gemacht.</em></h2></div>
          <div class="ek-zahlen">{ZAHLEN.map(([z, l]) => (<div><b>{z}</b><span>{l}</span></div>))}</div>
        </div>
        <ProofPaare ids={PAARE} />
        <div class="ek-zitate">
          <blockquote class="ek-zitat"><q>Ich habe nicht verstanden, warum ich es nicht schaffe, obwohl ich trainiert habe wie blöd. Heute weiss ich, dass es an anderen Themen liegt.</q><cite>Phuong, Kundin von Fit on Time</cite></blockquote>
          <blockquote class="ek-zitat"><q>Man hat mir nicht versprochen, in 14 Tagen 9 Kilo abzunehmen. Von Anfang an hiess es: langsamer ist besser.</q><cite>Milli, Kundin von Fit on Time</cite></blockquote>
          <blockquote class="ek-zitat"><q>Von 94 auf 78 Kilo, Juli 2024 bis August 2025.</q><cite>Coco, Kundin von Fit on Time</cite></blockquote>
        </div>
        <p style="margin-top:2rem"><button type="button" class="ek-btn ek-btn--voll" data-gender="frau" style="padding-left:2rem;padding-right:2rem">Check starten</button></p>
      </div>
    </section>
  </section>

  <!-- ===== 2 Fragen ===== -->
  <section class="ek-step" id="s-quiz" hidden>
    <div class="ek-wrap"><div class="ek-quiz">
      <div class="ek-prog" id="prog" aria-hidden="true">{FRAGEN.map(() => <i></i>)}</div>
      {FRAGEN.map((f, i) => (
        <div class="ek-frage" data-i={i} hidden>
          <h2>{f.q}</h2>
          <p class="ek-hinweis">Tipp auf die Zeile, die am ehesten passt.</p>
          <ul class="ek-opts">
            {f.a.map(([val, label, fb], k) => (
              <li><button type="button" class="ek-opt" data-q={i + 1} data-val={val} data-fb={fb}><span class="bu">{'ABCD'[k]}</span><span class="lb">{label}</span><span class="pf" aria-hidden="true">&rarr;</span></button></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="ek-feedback" id="feedback" aria-live="polite" hidden><span class="ek-kicker">Deine Coach sagt dazu</span><p id="fb-text"></p><button type="button" class="ek-weiter" id="fb-weiter">Weiter</button></div>
      <div class="ek-mini"><div><small>Deine Einladung entsteht</small><span>Thema: wird aus deinen Antworten ermittelt</span></div><div class="ek-punkte" id="punkte">{FRAGEN.map(() => <i></i>)}</div></div>
    </div></div>
  </section>

  <!-- ===== 3 Angaben ===== -->
  <section class="ek-step" id="s-form" hidden>
    <div class="ek-wrap"><div class="ek-quiz">
      <div class="ek-prog" aria-hidden="true">{FRAGEN.map(() => <i class="an"></i>)}</div>
      <p class="ek-kicker" style="margin-top:1.6rem">Deine Antworten sind ausgewertet</p>
      <h2 style="margin-top:0.7rem">Auf welchen Namen dürfen wir <em>deine Einladung ausstellen?</em></h2>
      <div class="ek-zwischen"><b id="zw-zahl">3/4</b><p><span class="ek-kicker" style="display:block;margin-bottom:0.2rem">Dein Zwischenergebnis</span><span id="zw-text"></span></p></div>
      <form id="leadform" novalidate>
        <div class="ek-felder">
          <div class="ek-feld"><label for="fn">Vorname</label><input id="fn" autocomplete="given-name" required maxlength="60" /></div>
          <div class="ek-feld"><label for="ln">Nachname</label><input id="ln" autocomplete="family-name" required maxlength="60" /></div>
          <div class="ek-feld ek-feld--breit"><label for="em">E-Mail</label><input id="em" type="email" autocomplete="email" required maxlength="200" /></div>
          <div class="ek-feld ek-feld--breit"><label for="ph">Handy</label><input id="ph" type="tel" inputmode="tel" autocomplete="tel" placeholder="+41 79 123 45 67" required maxlength="35" /></div>
          <div style="position:absolute;left:-99999px" aria-hidden="true"><label for="website">Website</label><input id="website" tabindex="-1" autocomplete="off" /></div>
        </div>
        <label class="ek-check"><input type="checkbox" id="wa" /><span>Meine Coach darf mir per WhatsApp schreiben und die Einladung mit mir durchgehen.</span></label>
        <label class="ek-check"><input type="checkbox" id="ds" required /><span>Ich bin einverstanden, dass Fit on Time meine Angaben für meine Workshop-Anfrage verwendet und mich per E-Mail oder Telefon kontaktieren darf, auch wenn ich keinen Termin auswähle. <a href={IMPRESSUM_URL} target="_blank" rel="noopener">Datenschutz</a></span></label>
        <div class="ek-fehler" id="fehler" role="alert"></div>
        <button type="submit" class="ek-btn ek-btn--voll ek-senden" id="senden">Einladung ausstellen &rarr;</button>
        <p class="ek-klein">Im nächsten Schritt wählst du deinen Termin.</p>
      </form>
      <div class="ek-zahlen" style="margin-top:1.75rem">{ZAHLEN.map(([z, l]) => (<div><b>{z}</b><span>{l}</span></div>))}</div>
    </div></div>
  </section>

  <!-- ===== 4 Einladung ===== -->
  <section class="ek-step" id="s-einl" hidden>
    <div class="ek-wrap ek-einl">
      <div class="ek-links">
        <p class="ek-kicker">Ausgewertet · 7 von 7</p>
        <h1 id="e-h1"><span class="e-h1-name"><span class="e-name">Du</span>, </span><em id="e-h1-rest">deine Antworten zeigen ein Muster.</em></h1>
        <ul class="ek-muster" id="muster"></ul>
        <p class="ek-deutung" id="deutung"></p>
        <p class="ek-darum">Deshalb laden wir dich ein:</p>
        <div class="ek-karte"><div class="ek-karte-innen">
          <div class="ek-karte-kopf"><span class="ek-kicker">Persönliche Einladung</span><i>Fit on Time</i></div>
          <p class="ek-karte-name"><span class="e-name">Du</span>,</p>
          <p class="ek-karte-intro">du bist eingeladen zu deinem</p>
          <p class="ek-karte-ws">1:1-Workshop</p>
          <dl><dt>Thema</dt><dd>Dein Stoffwechsel im Sparmodus</dd><dt>Format</dt><dd>Online, nur du und deine Coach</dd><dt>Termin</dt><dd>Wählst du gleich selbst</dd><dt>Wert</dt><dd><s>CHF 500</s>CHF 0 für dich</dd></dl>
        </div></div>
      </div>
      <div>
        <div class="ek-zusage" id="zusage">
          <p class="ek-kicker">Deine Zusage</p>
          <h2>Wähle deinen Termin.</h2>
          <p class="ek-soft">Such dir einen freien Termin aus. Die Bestätigung kommt per E-Mail.</p>
          <div class="ek-embed" id="bookingembed"></div>
        </div>
        <div class="ek-warum"><p class="ek-kicker">Ehrlich gesagt</p><h3>Warum kostet der Workshop nichts?</h3><p>Weil ein Teil der Frauen danach mit uns weitermacht. Das ist für uns Grund genug, uns Zeit für dich zu nehmen. Ob du das willst, entscheidest allein du. Den nächsten Schritt nimmst du so oder so mit.</p></div>
        <div style="margin-top:2.5rem">
          <p class="ek-kicker" style="margin-bottom:1rem">Frauen, die diesen Schritt gemacht haben</p>
          <ProofPaare ids={['21', '03', '13', '20']} />
          <div class="ek-zitate" style="grid-template-columns:1fr">
            <blockquote class="ek-zitat"><q>Man hat mir nicht versprochen, in 14 Tagen 9 Kilo abzunehmen. Von Anfang an hiess es: langsamer ist besser.</q><cite>Milli, Kundin von Fit on Time</cite></blockquote>
            <blockquote class="ek-zitat"><q>Von 94 auf 78 Kilo, Juli 2024 bis August 2025.</q><cite>Coco, Kundin von Fit on Time</cite></blockquote>
          </div>
          <div class="ek-zahlen" style="margin-top:1.75rem">{ZAHLEN.map(([z, l]) => (<div><b>{z}</b><span>{l}</span></div>))}</div>
        </div>
        <div class="ek-ablauf" style="margin-top:2.75rem">
          <p class="ek-kicker">Was im Workshop passiert</p>
          <h3 style="font-size:clamp(1.6rem,3.6vw,2.2rem);margin-top:0.5rem">Zeit nur für dich. <em>Kein Vortrag.</em></h3>
          <ol>{ABLAUF.map((s) => (<li><div><b>{s.t}</b><span>{s.d}</span></div></li>))}</ol>
        </div>
        <div class="ek-geschenk"><span class="ek-kicker">Dazu als Geschenk</span><span>Dein Fettabbau-Starter-Bundle: Einkaufsliste, 7-Tage-Reset und Notfallplan gegen Heisshunger. Du bekommst es im Workshop.</span></div>
      </div>
    </div>
    <div class="ek-sticky" id="sticky"><button type="button" class="ek-btn ek-btn--voll" id="sticky-btn">Termin wählen</button></div>
  </section>

  <footer class="ek-fuss"><div class="ek-wrap">
    <p>* Kostenloses Angebot nur, sofern es tatsächlich angeboten wird. Der Workshop ersetzt keine medizinische Diagnose. Bei Verdacht auf Erkrankungen der Schilddrüse oder des Stoffwechsels ist eine ärztliche Abklärung sinnvoll.</p>
    <p style="margin-top:0.5rem"><a href={IMPRESSUM_URL} target="_blank" rel="noopener">Impressum</a> · <a href={IMPRESSUM_URL} target="_blank" rel="noopener">Datenschutz</a></p>
    <div style="margin-top:10px"><ScaleeeCredit /></div>
  </div></footer>

  <CookieBanner metaPixelId="1316450223953563" googleAdsId={GOOGLE_ADS_ID} consentKey="fot_consent" impressumUrl={IMPRESSUM_URL} datenschutzUrl={IMPRESSUM_URL} />

  <script is:inline>
    // Tracking nach LP-Machine-Muster (__lp aus dem CookieBanner), Events wie im Figur-Check
    var SLUG = document.body.dataset.slug, LP_NAME = document.body.dataset.lpname, DIREKT = document.body.dataset.direkt === '1';
    function tk(e, d) {
      var tries = 0;
      (function fire() {
        if (window.__lp) {
          window.__lp.track(e, Object.assign({ page: SLUG }, d || {}), 'fot', LP_NAME);
          if (e === 'quiz_start') window.__lp.meta('ViewContent', { content_name: 'FoT Quiz Start', currency: 'CHF' });
          if (e === 'quiz_complete') window.__lp.meta('CompleteRegistration', { content_name: 'FoT Quiz Complete', currency: 'CHF' });
          if (e === 'lead_submit') window.__lp.meta('Lead', { content_name: 'FoT Lead', currency: 'CHF' });
        } else if (tries++ < 40) { setTimeout(fire, 50); }
      })();
    }
    tk('page_view');
  </script>
  <script is:inline>
    // Ablauf: Start -> 7 Fragen (Rückmeldung, Auto-Weiter) -> Zwischenergebnis + Opt-in -> Einladung mit Kalender
    var answers = {}, started = false, leadFired = false, savedData = '', bookingLoaded = false, current = 0, timer = null;
    var steps = { start: 'Start', quiz: 'Frage', form: 'Fast fertig', einl: 'Deine Einladung' };
    // Antworten, die als Anzeichen zählen, plus Satz für das Muster
    var ANZEICHEN = {
      1: { extrem: 'Abnehmen fällt dir extrem schwer, obwohl du auf deine Ernährung achtest.', mittel: 'Abnehmen fällt dir nicht leicht, obwohl du auf deine Ernährung achtest.' },
      2: { staendig: 'Du frierst ständig.', fuesse: 'Du hast oft kalte Füsse.' },
      3: { fastimmer: 'Du bist fast immer erschöpft, egal, wie lange du schläfst.', nachmittags: 'Du bist oft am Nachmittag erschöpft.' },
      4: { sehroft: 'Du hast sehr oft Wassereinlagerungen.', gelegentlich: 'Du hast gelegentlich Wassereinlagerungen.' },
    };
    function $(id) { return document.getElementById(id); }
    function show(name) {
      ['start', 'quiz', 'form', 'einl'].forEach(function (n) { $('s-' + n).hidden = n !== name; });
      $('kopf-tag').textContent = name === 'quiz' ? 'Frage ' + (current + 1) + ' von 7' : steps[name] === 'Start' ? '1:1-Workshop' : steps[name];
      window.scrollTo(0, 0);
    }
    function zeigeFrage(i) {
      current = i;
      document.querySelectorAll('.ek-frage').forEach(function (f) { f.hidden = +f.dataset.i !== i; });
      document.querySelectorAll('#prog i, #punkte i').forEach(function (el, k) { el.classList.toggle('an', k % 7 < i); });
      $('feedback').hidden = true;
      $('kopf-tag').textContent = 'Frage ' + (i + 1) + ' von 7';
      window.scrollTo(0, 0);
    }
    function anzeichen() {
      var liste = [];
      for (var q = 1; q <= 4; q++) { var v = answers['q' + q + '_val']; if (ANZEICHEN[q][v]) liste.push(ANZEICHEN[q][v]); }
      return liste;
    }
    function weiter() {
      clearTimeout(timer);
      if (current < 6) { zeigeFrage(current + 1); return; }
      tk('quiz_complete');
      if (DIREKT) { zeigeEinladung({ fn: '', ln: '', em: '', ph: '' }); return; }
      var n = anzeichen().length;
      $('zw-zahl').textContent = n + '/4';
      $('zw-text').textContent = n >= 2
        ? 'Bei dir zeigen sich ' + n + ' von 4 typischen Anzeichen für einen Stoffwechsel im Sparmodus. Was das heisst, steht in deiner Einladung.'
        : n === 1 ? 'Bei dir zeigt sich 1 von 4 typischen Anzeichen. Was trotzdem bremsen kann, steht in deiner Einladung.'
        : 'Bei dir zeigen sich kaum typische Anzeichen. Was trotzdem bremsen kann, steht in deiner Einladung.';
      show('form');
    }
    document.querySelectorAll('[data-gender]').forEach(function (b) {
      b.addEventListener('click', function () {
        answers.gender = b.dataset.gender;
        if (!started) { started = true; tk('quiz_start', { detail: 'gender_' + answers.gender }); }
        show('quiz'); zeigeFrage(0);
      });
    });
    document.querySelectorAll('.ek-opt').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!$('feedback').hidden && b.classList.contains('gewaehlt')) { weiter(); return; }
        var q = b.dataset.q;
        answers['q' + q] = b.querySelector('.lb').textContent.trim();
        answers['q' + q + '_val'] = b.dataset.val;
        tk('quiz_answer', { detail: 'q' + q + '_' + b.dataset.val });
        b.closest('.ek-opts').querySelectorAll('.ek-opt').forEach(function (o) { o.classList.remove('gewaehlt'); o.querySelector('.pf').textContent = '→'; });
        b.classList.add('gewaehlt'); b.querySelector('.pf').textContent = '✓';
        $('fb-text').textContent = b.dataset.fb;
        $('feedback').hidden = false;
        clearTimeout(timer); timer = setTimeout(weiter, 2200);
      });
    });
    $('fb-weiter').addEventListener('click', weiter);

    function normalizePhone(raw) {
      var c = (raw || '').replace(/[^\d+]/g, '');
      if (!c) return '';
      if (c.indexOf('00') === 0) return '+' + c.slice(2);
      if (c.charAt(0) === '+') return c;
      if (c.charAt(0) === '0') return '+41' + c.slice(1);
      return '+41' + c;
    }
    function baueEinladung(vorname) {
      document.querySelectorAll('.e-name').forEach(function (el) { el.textContent = vorname || 'Für dich'; });
      // Ohne Namen (Variante B) beginnt die Überschrift direkt mit "Deine Antworten ..."
      $('e-h1').classList.toggle('ohne-name', !vorname);
      var liste = anzeichen(), ul = $('muster');
      ul.innerHTML = '';
      liste.forEach(function (s) { var li = document.createElement('li'); li.textContent = s; ul.appendChild(li); });
      ul.hidden = liste.length === 0;
      if (liste.length >= 2) {
        $('e-h1-rest').textContent = DIREKT ? 'Deine Antworten zeigen ein Muster.' : 'deine Antworten zeigen ein Muster.';
        $('deutung').textContent = 'Einzeln wirkt das harmlos. Zusammen ist es ein Muster, das wir oft sehen, wenn der Stoffwechsel im Sparmodus läuft. Was es bei dir ist und was du dagegen tun kannst, klären wir in deinem 1:1-Workshop.';
      } else {
        $('e-h1-rest').textContent = DIREKT ? 'Deine Antworten sind ausgewertet.' : 'deine Antworten sind ausgewertet.';
        $('deutung').textContent = 'Typische Sparmodus-Anzeichen zeigen sich bei dir kaum. Wenn sich dein Gewicht trotzdem nicht bewegt, bremst oft etwas anderes. Genau das finden wir in deinem 1:1-Workshop heraus.';
      }
    }
    function ladeKalender(d) {
      if (bookingLoaded) return;
      bookingLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://embed.ycb.me'; s.async = true;
      s.dataset.domain = 'fitontime-workshop'; s.dataset.displaymode = 'auto';
      $('bookingembed').appendChild(s);
      tk('booking_embed_loaded');
      // Name, Mail und Handy an den Kalender übergeben (YCBM-Kürzel), damit nur noch der Termin fehlt
      var werte = { FNAME: d.fn, LNAME: d.ln, EMAIL: d.em, PHONE: d.ph }, versuche = 0;
      if (!d.em) return;
      (function warte() {
        var f = document.querySelector('#bookingembed iframe');
        if (!f) { if (versuche++ < 200) setTimeout(warte, 50); return; }
        var q = Object.keys(werte).filter(function (k) { return werte[k]; }).map(function (k) { return k + '=' + encodeURIComponent(werte[k]); }).join('&');
        if (q && f.src.indexOf('EMAIL=') === -1) f.src = f.src + (f.src.indexOf('?') === -1 ? '?' : '&') + q;
      })();
    }
    $('leadform').addEventListener('submit', function (e) {
      e.preventDefault();
      var fehler = $('fehler'); fehler.classList.remove('show');
      if ($('website').value) return;
      var fn = $('fn').value.trim(), ln = $('ln').value.trim(), em = $('em').value.trim(), ph = normalizePhone($('ph').value);
      if (!fn || !ln || !em || !ph || !$('ds').checked) { fehler.textContent = 'Bitte fülle alle Felder aus und bestätige den Datenschutz.'; fehler.classList.add('show'); return; }
      var d = { fn: fn, ln: ln, em: em, ph: ph }, now = JSON.stringify(d);
      if (savedData === now) { zeigeEinladung(d); return; }
      var n = anzeichen().length, btn = $('senden');
      btn.disabled = true; btn.textContent = 'Einladung wird ausgestellt …';
      fetch('/api/sheets', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lp_slug: SLUG, lp_name: LP_NAME, name: fn + ' ' + ln, first_name: fn, email: em, phone: ph,
          // Ohne Anzeichen gibt es keinen sinnvollen Prozentwert für den Bot-Opener, dann nur Setter
          wa_optin: $('wa').checked && n > 0, score: n * 25, answers: answers,
        }),
      }).then(function (res) {
        if (!res.ok) return res.json().catch(function () { return {}; }).then(function (j) { throw new Error(j && j.error ? j.error : 'insert-failed'); });
        savedData = now;
        try { sessionStorage.setItem('fot_sd_lead', JSON.stringify({ email: em, phone: ph })); sessionStorage.setItem('fot_result_name', fn); } catch (x) {}
        if (!leadFired) { leadFired = true; tk('lead_submit', { detail: 'anzeichen_' + n }); }
        zeigeEinladung(d);
      }).catch(function (err) {
        fehler.textContent = (window.__lpErr ? window.__lpErr(err.message) : 'Deine Angaben konnten nicht gespeichert werden. Bitte prüfe sie und versuche es erneut.');
        fehler.classList.add('show');
      }).finally(function () { btn.disabled = false; btn.textContent = 'Einladung ausstellen →'; });
    });
    function zeigeEinladung(d) {
      baueEinladung(d.fn);
      show('einl');
      ladeKalender(d);
      if (window.__ekSticky) setTimeout(window.__ekSticky, 50);
      tk('result_shown', { detail: 'einladung' });
    }
    // Fester Termin-Knopf auf dem Handy, solange der Kalender nicht im Bild ist
    (function () {
      var sticky = $('sticky'), ziel = $('zusage');
      $('sticky-btn').addEventListener('click', function () { tk('sticky_cta_click'); ziel.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      if (!('IntersectionObserver' in window)) return;
      var obs = new IntersectionObserver(function (es) { es.forEach(function (en) { sticky.classList.toggle('zeigen', !en.isIntersecting && !$('s-einl').hidden); }); }, { threshold: 0.15 });
      obs.observe(ziel);
      // Beim Anzeigen der Einladung neu messen, sonst bleibt der Zustand von vorher (versteckt) stehen
      window.__ekSticky = function () { obs.unobserve(ziel); obs.observe(ziel); };
    })();
    // Selbst-Buchung an den WhatsApp-Bot melden (kein Opener mehr). booking_confirmed feuert /workshop/gebucht.
    window.addEventListener('message', function (ev) {
      var o = String(ev.origin || '');
      if (!/(^|\.)ycb\.me$/.test(o) && o.indexOf('youcanbook') === -1) return;
      var t = ''; try { t = (typeof ev.data === 'string' ? ev.data : JSON.stringify(ev.data)).toLowerCase(); } catch (x) { return; }
      if (t.indexOf('book') === -1 || !/confirm|complete|created|success|made|finished/.test(t) || t.indexOf('cancel') !== -1) return;
      try { if (sessionStorage.getItem('fot_booked_reported') === '1') return; sessionStorage.setItem('fot_booked_reported', '1'); } catch (x) {}
      try { var l = JSON.parse(sessionStorage.getItem('fot_sd_lead') || '{}'); if (l.email || l.phone) fetch('/api/booked', { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true, body: JSON.stringify(l) }).catch(function () {}); } catch (x) {}
    });
  </script>
</body>
</html>
