---
// Wortmarke "FIT on TIME" wie auf der neuen fitontime.ch (Fraunces + Uhr-Signet).
// Styles kommen aus src/styles/bauchfett.css (.wordmark).
interface Props { dark?: boolean; href?: string; }
const { dark = false, href = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['wordmark', { 'wordmark--dark': dark }]} href={href || undefined} role="img" aria-label="Fit on Time">
  <span>FIT</span>
  <span class="on">
    <svg viewBox="0 0 48 54" aria-hidden="true">
      <rect x="20.6" y="1" width="6.8" height="4.6" rx="1.7" class="mk-accent-fill"></rect>
      <rect x="22.8" y="5.2" width="2.4" height="3.6" class="mk-accent-fill"></rect>
      <circle cx="24" cy="31.5" r="16.3" fill="none" class="mk-accent-stroke" stroke-width="2.5"></circle>
      <circle cx="24" cy="31.5" r="11" fill="none" class="mk-accent-stroke" stroke-width="1.5" stroke-dasharray="0.1 3.35" stroke-linecap="round" opacity="0.75"></circle>
      <line x1="24" y1="31.5" x2="30.2" y2="23.2" class="mk-ink-stroke" stroke-width="2.5" stroke-linecap="round"></line>
      <circle cx="24" cy="31.5" r="2.3" class="mk-ink-fill"></circle>
    </svg>
    <span class="n">n</span>
  </span>
  <span>TIME</span>
</Tag>
