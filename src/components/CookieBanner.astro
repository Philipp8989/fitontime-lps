---
// DSGVO-konformer Cookie-Banner  -  LP Machine (v2)
// Meta Pixel + Hyros NUR nach Consent.
// Verbesserungen v2: event_id, sendBeacon, noscript-Fallback, consent-Key pro Kunde
export interface Props {
  metaPixelId?: string;
  hyrosPh?: string;
  googleAdsId?: string;
  impressumUrl: string;
  datenschutzUrl: string;
  consentKey?: string;
}
const {
  metaPixelId = '',
  hyrosPh = '',
  googleAdsId = '',
  impressumUrl,
  datenschutzUrl,
  consentKey = 'lp_consent',
} = Astro.props;
---
<div id="cc-banner" class="cc-banner" hidden>
  <div class="cc-inner">
    <div class="cc-text">
      <h3>Cookies & Tracking</h3>
      <p>
        Wir verwenden Cookies und Tracking-Tools (Meta, Google, Hyros), um unsere Angebote zu verbessern und
        relevante Werbung auszuspielen. Du kannst selbst entscheiden, was du erlaubst.
        Mehr Infos in unserer <a href={datenschutzUrl} target="_blank" rel="noopener">Datenschutzerklärung</a>.
      </p>
    </div>
    <div class="cc-actions">
      <button type="button" class="cc-btn cc-ghost" data-cc="essential">Nur Notwendige</button>
      <button type="button" class="cc-btn cc-primary" data-cc="all">Alle akzeptieren</button>
    </div>
    <div class="cc-links">
      <a href={impressumUrl} target="_blank" rel="noopener">Impressum</a>
      <span>·</span>
      <a href={datenschutzUrl} target="_blank" rel="noopener">Datenschutz</a>
    </div>
  </div>
</div>

{/* Persistente Legal-Bar: Impressum + Datenschutz IMMER sichtbar (DSGVO / § 5 TMG).
    Versteckt sich nur, solange der Cookie-Consent-Banner selbst offen ist (hat die Links bereits). */}
<div id="lp-legal-bar" class="lp-legal-bar" aria-label="Rechtliche Hinweise">
  <a href={impressumUrl} target="_blank" rel="noopener">Impressum</a>
  <span aria-hidden="true">·</span>
  <a href={datenschutzUrl} target="_blank" rel="noopener">Datenschutz</a>
</div>

{/* noscript-Fallback: feuert PageView ohne JS (DSGVO: nur wenn Consent vorliegt, daher minimal) */}
{metaPixelId && (
  <noscript>
    <img height="1" width="1" style="display:none"
      src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
      alt="" />
  </noscript>
)}

<style is:global>
  .cc-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99999;
    background: rgba(10, 10, 10, 0.97);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    animation: cc-up .35s ease-out;
  }
  @keyframes cc-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .cc-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 20px 20px 16px;
    display: grid;
    gap: 14px;
  }
  .cc-text h3 { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: #fff; }
  .cc-text p { font-size: 13px; line-height: 1.55; color: #999999; }
  .cc-text a { color: #FF8534; text-decoration: underline; }
  .cc-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .cc-btn {
    flex: 1 1 auto;
    min-width: 140px;
    padding: 12px 18px;
    border-radius: 10px;
    font: 700 14px/1 'Inter', system-ui, sans-serif;
    cursor: pointer;
    border: 0;
    transition: transform .15s, opacity .15s, background .15s;
  }
  .cc-btn:active { transform: scale(.98); }
  .cc-primary { background: #E8630A; color: #fff; }
  .cc-primary:hover { background: #FF8534; }
  .cc-ghost { background: transparent; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.18); }
  .cc-ghost:hover { border-color: rgba(255, 255, 255, 0.32); }
  .cc-links { font-size: 11px; color: #666; text-align: center; display: flex; gap: 8px; justify-content: center; }
  .cc-links a { color: #666; text-decoration: none; }
  .cc-links a:hover { color: #999; }
  @media (min-width: 720px) {
    .cc-inner { grid-template-columns: 1fr auto; align-items: center; padding: 22px 28px 18px; }
    .cc-text { grid-column: 1 / 2; }
    .cc-actions { grid-column: 2 / 3; flex-wrap: nowrap; }
    .cc-btn { min-width: 160px; flex: 0 0 auto; }
    .cc-links { grid-column: 1 / -1; margin-top: 4px; }
  }

  /* DSGVO Legal-Bar: persistent, dezent, unten zentriert.
     Liegt unter dem Cookie-Consent-Banner (z-index 99999) und versteckt sich,
     solange der Banner offen ist (Banner zeigt die Links bereits). */
  .lp-legal-bar {
    position: fixed;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    font: 500 11px/1 'Inter', system-ui, -apple-system, sans-serif;
    color: #aaa;
    white-space: nowrap;
    pointer-events: auto;
  }
  .lp-legal-bar a { color: #ddd; text-decoration: none; }
  .lp-legal-bar a:hover { color: #fff; text-decoration: underline; }
  .lp-legal-bar span { color: #666; }
  /* Wenn Cookie-Consent-Banner aktiv ist (kein [hidden]): Legal-Bar ausblenden */
  #cc-banner:not([hidden]) ~ .lp-legal-bar { display: none; }

  /* === Buchungs-Widget Lade-Platzhalter (alle YCBM-Container) ===
     YCBM braucht ~10s bis das iframe rendert. Bis dahin Spinner + Text statt
     weisser Kasten. Das iframe (z-index 2, weisser Hintergrund) deckt den
     Platzhalter automatisch ab, sobald es geladen ist. Rein visuell, kein JS. */
  [id^="ycbm-container"], [id^="ycbm-embed"], [id^="ycb-embed"] { position: relative; min-height: 480px; }
  [id^="ycbm-container"]::before, [id^="ycbm-embed"]::before, [id^="ycb-embed"]::before {
    content: "Kalender wird geladen \2026";
    position: absolute; inset: 0;
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: calc(50% - 60px);
    background: #fff; color: #8a8a8a;
    font: 500 14px/1.4 system-ui, -apple-system, sans-serif; text-align: center;
    z-index: 0;
  }
  [id^="ycbm-container"]::after, [id^="ycbm-embed"]::after, [id^="ycb-embed"]::after {
    content: ""; position: absolute; top: calc(50% - 46px); left: 50%;
    width: 32px; height: 32px; margin-left: -16px;
    border: 3px solid rgba(0,0,0,0.12); border-top-color: rgba(0,0,0,0.5);
    border-radius: 50%; animation: ycbm-spin .8s linear infinite; z-index: 1;
  }
  [id^="ycbm-container"] iframe, [id^="ycbm-embed"] iframe, [id^="ycb-embed"] iframe { position: relative; z-index: 2; background: #fff; }
  @keyframes ycbm-spin { to { transform: rotate(360deg); } }
</style>

<script is:inline define:vars={{ metaPixelId, hyrosPh, googleAdsId, consentKey }}>
  (function () {
    var KEY = consentKey;
    var banner = document.getElementById('cc-banner');
    var current = null;
    try { current = localStorage.getItem(KEY); } catch (e) {}

    // Google Ads gtag mit Consent Mode v2: Tag laedt sofort (cookielose Pings fuer
    // Conversion-Modeling), Cookies/Personalisierung erst nach "Alle akzeptieren".
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    if (!window.gtag) window.gtag = gtag;
    if (googleAdsId && !window.__lpGtagLoaded) {
      window.__lpGtagLoaded = true;
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied'
      });
      var gs = document.createElement('script');
      gs.async = true;
      gs.src = 'https://www.googletagmanager.com/gtag/js?id=' + googleAdsId;
      document.head.appendChild(gs);
      window.gtag('js', new Date());
      window.gtag('config', googleAdsId);
    }
    function grantGoogleConsent() {
      if (!googleAdsId) return;
      window.gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted'
      });
    }

    // Event-ID Generator für Meta-Deduplizierung
    function eid() {
      return Date.now() + '-' + Math.random().toString(36).slice(2, 10);
    }

    function readCookie(name) {
      try {
        var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
        return m ? decodeURIComponent(m[1]) : '';
      } catch (e) { return ''; }
    }

    function consented() {
      try { return localStorage.getItem(KEY) === 'all'; } catch (e) { return false; }
    }

    // ── Kanal-Erkennung ────────────────────────────────────────────────
    // Auf denselben Landingpages laufen Google- und Meta-Ads gleichzeitig. Ohne
    // diese Erkennung meldet jede Seite jeden Lead an beide Netzwerke.
    // Der Klick wird beim ersten Aufruf gespeichert und gilt 30 Tage
    // (= Google-Lookback), damit auch die spaetere Terminbuchung zuordenbar ist.
    var CLICK_KEY = 'lp_click';
    var CLICK_TTL = 30 * 86400000;

    // Rohwerte, die mit dem Lead in die CRM-Datenbank wandern. Ohne sie steht im
    // CRM zwar der Lead, aber nicht der Kanal — und Google-Ads-Offline-Conversions
    // lassen sich ohne gclid gar nicht zurueckspielen.
    var CLICK_IDS = ['gclid', 'gbraid', 'wbraid', 'fbclid', 'ttclid', 'msclkid'];
    var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'utm_id'];

    function readClick() {
      try {
        var c = JSON.parse(localStorage.getItem(CLICK_KEY) || 'null');
        if (!c || !c.ts || Date.now() - c.ts > CLICK_TTL) return null;
        return c;
      } catch (e) { return null; }
    }

    // Externer Referrer der Einstiegsseite. Eigene URLs sind wertlos (Folgeseiten-Klicks).
    function extRef() {
      try {
        var r = document.referrer || '';
        if (!r || r.indexOf(location.origin) === 0) return '';
        return r.slice(0, 300);
      } catch (e) { return ''; }
    }

    function storeClick(c) {
      try { localStorage.setItem(CLICK_KEY, JSON.stringify(c)); } catch (e) {}
      return c;
    }

    function detectClick() {
      var qs, g = '', fb = '', src = '', params = {};
      try {
        qs = new URLSearchParams(location.search);
        var all = CLICK_IDS.concat(UTM_KEYS);
        for (var i = 0; i < all.length; i++) {
          var v = qs.get(all[i]);
          if (v) params[all[i]] = v.slice(0, 400);
        }
        g = qs.get('gclid') || qs.get('gbraid') || qs.get('wbraid') || '';
        fb = qs.get('fbclid') || '';
        src = (qs.get('utm_source') || '').toLowerCase();
      } catch (e) {}
      // Ohne eigenen Klick-Parameter bleibt der zuvor gespeicherte Kanal stehen.
      if (!g && !fb && !src) {
        var prev = readClick();
        if (prev) {
          // Referrer nachtragen, solange kein echter Klick gespeichert ist: Wer zuerst
          // direkt landet und spaeter ueber eine nicht getaggte Anzeige zurueckkommt,
          // haette sonst gar keine Herkunft. Eine vorhandene Klick-Attribution bleibt
          // unangetastet — der Erstklick gewinnt.
          if (!prev.ref && !prev.google && !prev.meta) {
            var r = extRef();
            if (r) { prev.ref = r; storeClick(prev); }
          }
          return prev;
        }
        // Erster Besuch ohne Klick-Parameter: nur den Referrer festhalten (z.B.
        // youtube.com bei nicht getaggten Ads). google/meta bleiben bewusst false,
        // damit die Conversion-Gates unveraendert nur auf echte Klick-IDs reagieren.
        return storeClick({ google: false, meta: false, src: '', params: {}, ref: extRef(), landing: location.pathname, ts: Date.now() });
      }
      return storeClick({
        google: !!g || src.indexOf('google') === 0 || src === 'youtube' || src === 'yt',
        meta: !!fb || src === 'meta' || src === 'facebook' || src === 'fb' || src === 'instagram' || src === 'ig',
        src: src || (g ? 'google' : (fb ? 'meta' : '')),
        params: params,
        ref: extRef(),
        landing: location.pathname,
        ts: Date.now(),
      });
    }

    var lpClick = detectClick();

    // Google-Klick nachweisbar? URL-Parameter, gespeicherter Klick oder _gcl_aw-Cookie.
    function hasGoogleClick() {
      var c = lpClick || readClick();
      if (c && c.google) return true;
      return !!readCookie('_gcl_aw');
    }

    function channelName() {
      var c = lpClick || readClick();
      if (c && c.google) return 'google';
      if (c && c.meta) return 'meta';
      // Wiederkehrer ohne Klick-Parameter: die Netzwerk-Cookies verraten die Herkunft.
      if (readCookie('_gcl_aw')) return 'google';
      if (readCookie('_fbc')) return 'meta';
      return (c && c.src) || 'direct';
    }

    // Kanal als Query-Parameter an /api/track haengen — synchron moeglich,
    // anders als der sendBeacon-Blob, der sich nicht mehr auslesen laesst.
    function tagTrackUrl(url) {
      try {
        if (!/\/api\/track\b/.test(url) || /[?&]ch=/.test(url)) return url;
        var c = lpClick || readClick();
        var q = 'ch=' + encodeURIComponent(channelName());
        if (c && c.src) q += '&src=' + encodeURIComponent(c.src);
        return url + (url.indexOf('?') === -1 ? '?' : '&') + q;
      } catch (e) { return url; }
    }

    if (!window.__lpBeaconPatched && navigator.sendBeacon) {
      window.__lpBeaconPatched = true;
      var origBeacon = navigator.sendBeacon.bind(navigator);
      navigator.sendBeacon = function (url, data) {
        try { return origBeacon(tagTrackUrl(String(url)), data); } catch (e) { return origBeacon(url, data); }
      };
    }

    // Attributions-Paket fuer den Lead-Insert ins CRM: gespeicherte Klick-IDs + UTMs
    // des Erstkontakts, dazu Kanal, Einstiegs-Referrer und die Seite des Opt-ins.
    // Ueberlebt Folgeseiten, weil die Werte aus localStorage kommen (30 Tage).
    function attrObj() {
      var c = lpClick || readClick() || {};
      var p = c.params || {};
      var a = {};
      for (var k in p) {
        if (Object.prototype.hasOwnProperty.call(p, k) && p[k]) a[k] = p[k];
      }
      a.channel = channelName();
      if (c.ref) a.landing_ref = c.ref;
      if (c.landing) a.landing_path = c.landing;
      try { a.page = location.pathname; } catch (e) {}
      return a;
    }

    // Geteilte Lead-event_id: capiMetaObj() erzeugt sie, meta('Lead') verwendet dieselbe → Dedup mit CAPI.
    var pendingLeadEid = null;
    function capiMetaObj() {
      pendingLeadEid = eid();
      return { consent: consented(), event_id: pendingLeadEid, fbp: readCookie('_fbp'), fbc: readCookie('_fbc') };
    }

    // Hyros Auto-Capture AUS: Universal-Script sendet getippte E-Mails/Telefone sonst
    // schon bei Eingabe (change/keyup) an Hyros — auch bei Formular-Abbrechern.
    // Inputs mit Klasse "hyros-ignore" werden vom Script komplett uebersprungen.
    // Lead-Meldung an Hyros passiert stattdessen submit-only im fetch-Wrapper unten.
    function hyrosShield() {
      var list = document.querySelectorAll('input:not(.hyros-ignore)');
      for (var i = 0; i < list.length; i++) list[i].classList.add('hyros-ignore');
    }
    hyrosShield();
    document.addEventListener('DOMContentLoaded', hyrosShield);
    try {
      new MutationObserver(hyrosShield).observe(document.documentElement, { childList: true, subtree: true });
    } catch (e) {}

    // fetch-Wrapper: haengt {meta:...} automatisch an jeden /api/sheets-POST (Server-CAPI braucht event_id+consent)
    // und {attr:...} an jeden Lead-POST (/api/sheets + /api/recruiting), damit Klick-IDs und UTMs
    // im CRM landen. Zusaetzlich: Hyros-Lead erst NACH erfolgreichem Insert melden (hyros_email-Event,
    // wird vom Universal-Script validiert und als Lead angelegt; Telefon via window.hrs).
    if (!window.__lpFetchPatched) {
      window.__lpFetchPatched = true;
      var origFetch = window.fetch;
      window.fetch = function (input, init) {
        var hyrosLead = null;
        try {
          var url = typeof input === 'string' ? input : (input && input.url) || '';
          // sendBeacon-Fallback laeuft ueber fetch — Kanal auch hier anhaengen.
          if (typeof input === 'string' && /\/api\/track\b/.test(url)) {
            input = tagTrackUrl(url);
            arguments[0] = input;
          }
          var opts = init || (typeof input === 'object' ? input : null);
          var isSheets = /\/api\/sheets\b/.test(url);
          var isLeadPost = isSheets || /\/api\/recruiting\b/.test(url);
          if (opts && (opts.method || '').toUpperCase() === 'POST' && isLeadPost &&
              typeof opts.body === 'string' && opts.body.charAt(0) === '{') {
            var b = JSON.parse(opts.body);
            var changed = false;
            // Meta-CAPI nur fuer den Marketing-Funnel — Recruiting laeuft ohne Pixel-Lead.
            if (b && isSheets && !b.meta) { b.meta = capiMetaObj(); changed = true; }
            if (b && !b.attr) { b.attr = attrObj(); changed = true; }
            if (changed) opts.body = JSON.stringify(b);
            if (b && isSheets && b.email) hyrosLead = { email: String(b.email), phone: String(b.phone || '') };
          }
        } catch (e) {}
        var p = origFetch.apply(this, arguments);
        if (hyrosLead) {
          p.then(function (res) {
            if (!res || !res.ok) return;
            try { window.dispatchEvent(new CustomEvent('hyros_email', { detail: { email: hyrosLead.email } })); } catch (e) {}
            try { if (hyrosLead.phone && window.hrs) window.hrs.addLeadPhone(hyrosLead.phone); } catch (e) {}
          }, function () {});
        }
        return p;
      };
    }

    function loadMetaPixel() {
      if (!metaPixelId || window.fbq) return;
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s);}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', metaPixelId);
      window.fbq('track', 'PageView', {}, { eventID: eid() });
    }

    function loadHyros() {
      if (!hyrosPh) return;
      var s = document.createElement('script');
      s.type = 'text/javascript';
      s.async = true;
      s.src = 'https://t.hyros.com/v1/lst/universal-script?ph=' + hyrosPh;
      document.head.appendChild(s);
    }

    function applyConsent(level) {
      try { localStorage.setItem(KEY, level); } catch (e) {}
      if (banner) banner.hidden = true;
      if (level === 'all') {
        loadMetaPixel();
        loadHyros();
        grantGoogleConsent();
      }
    }

    if (current === 'all') {
      loadMetaPixel();
      loadHyros();
      grantGoogleConsent();
    } else if (current !== 'essential') {
      if (banner) banner.hidden = false;
    }

    document.querySelectorAll('[data-cc]').forEach(function (el) {
      el.addEventListener('click', function () {
        applyConsent(el.getAttribute('data-cc'));
      });
    });

    // Globale Tracking-Helfer auf window für inline-Scripts
    window.__lp = {
      eid: eid,
      consented: consented,
      capiMeta: capiMetaObj,
      // Kanal des Besuchers: 'google' | 'meta' | utm_source | 'direct'
      channel: channelName,
      // Klick-IDs + UTMs des Erstkontakts (wird automatisch an Lead-POSTs gehaengt)
      attr: attrObj,
      hasGoogleClick: hasGoogleClick,
      // Meta-Event mit event_id feuern. Bei 'Lead' die von capiMetaObj() erzeugte ID nutzen (Dedup mit CAPI).
      meta: function(eventName, params) {
        var id = (eventName === 'Lead' && pendingLeadEid) ? pendingLeadEid : eid();
        if (eventName === 'Lead') pendingLeadEid = null;
        if (typeof fbq === 'function') {
          fbq('track', eventName, params || {}, { eventID: id });
        }
        return id;
      },
      // Google-Ads-Event feuern. Mit label als Conversion (send_to AW-ID/Label),
      // ohne label als benanntes Event (fuer spaetere Conversion-Aktionen/Remarketing).
      google: function(eventName, label, params) {
        if (!googleAdsId || typeof window.gtag !== 'function') return;
        // Auf der geteilten Landingpage laeuft auch Meta-Traffic. Ohne nachweisbaren
        // Google-Klick wuerde Google fremde Leads mitmodellieren — deshalb hier Schluss.
        if (!hasGoogleClick()) return;
        if (label) {
          window.gtag('event', 'conversion', Object.assign({ send_to: googleAdsId + '/' + label }, params || {}));
        } else {
          window.gtag('event', eventName, params || {});
        }
      },
      // Dashboard-Event per sendBeacon (navigations-sicher)
      track: function(event, data, funnel, funnelName) {
        var sid = sessionStorage.getItem('lp_sid');
        if (!sid) { sid = crypto.randomUUID(); sessionStorage.setItem('lp_sid', sid); }
        var payload = JSON.stringify(Object.assign({
          event: event,
          sessionId: sid,
          funnel: funnel || '',
          funnelName: funnelName || '',
          timestamp: new Date().toISOString(),
        }, data || {}));
        var sent = navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
        if (!sent) {
          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true,
          }).catch(function(){});
        }
      }
    };
  })();
</script>
