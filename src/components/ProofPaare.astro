---
// Vorher-Nachher-Paare im Look der neuen LPs (Cream, Hairline, Gold).
// Die Fotos stammen aus den alten blauen Collagen, zugeschnitten mit scripts/proof-paare.py.
// Mobil als Reihe zum Wischen, ab 720px vier Spalten.
interface Props { ids?: string[]; }
const { ids = ['14', '21', '22', '23'] } = Astro.props;
---
<div class="paare">
  {ids.map((n) => (
    <figure class="paar">
      <div class="paar-bilder">
        <img src={`/images/sd-proof/paare/tf-${n}-vorher.jpg`} alt="Kundin von Fit on Time vorher" width="416" height="694" loading="lazy" />
        <img src={`/images/sd-proof/paare/tf-${n}-nachher.jpg`} alt="Kundin von Fit on Time nachher" width="416" height="694" loading="lazy" />
      </div>
      <figcaption><span>Vorher</span><span>Nachher</span></figcaption>
    </figure>
  ))}
</div>

<style>
  .paare { display: flex; gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0 -1rem; padding: 0 1rem 0.5rem; scrollbar-width: none; }
  .paare::-webkit-scrollbar { display: none; }
  .paar { flex: 0 0 78%; margin: 0; scroll-snap-align: center; }
  .paar-bilder { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; border: var(--hairline); border-radius: 6px; overflow: hidden; background: var(--cream-bright); }
  .paar-bilder img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 5; object-fit: cover; }
  .paar figcaption { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin-top: 0.5rem; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  .paar figcaption span + span { color: var(--gold); }
  @media (min-width: 720px) {
    .paare { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; overflow: visible; margin: 0; padding: 0; }
    .paar { flex: none; }
  }
</style>
